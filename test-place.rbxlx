-- Script to run all simplified tests

local ServerStorage = game:GetService("ServerStorage")
local TestRunner = require(ServerStorage.Tests.TestRunner)

-- Find all test files
local function findTestFiles(folder)
    local testFiles = {}
    
    local function scan(folder)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Folder") then
                scan(child)
            elseif child:IsA("ModuleScript") and 
                   (child.Name:match("%.spec$") or child.Name:match("%.simplified$") or child.Name:match("%.fixed$")) then
                table.insert(testFiles, child)
            end
        end
    end
    
    scan(ServerStorage.Tests)
    return testFiles
end

-- Main function
local function main()
    print("\n" .. string.rep("=", 50))
    print("STARTING TEST RUN")
    print(string.rep("=", 50))
    
    local testFiles = findTestFiles(ServerStorage.Tests)
    
    if #testFiles == 0 then
        print("No test files found!")
        return
    end
    
    print("Found " .. #testFiles .. " test files:")
    for i, file in ipairs(testFiles) do
        print(string.format("%d. %s", i, file:GetFullName()))
    end
    
    -- Initialize test runner
    local runner = TestRunner
    
    -- Run all tests
    for _, testFile in ipairs(testFiles) do
        runner:runTest(testFile)
    end
    
    -- Print summary
    print(runner:getSummary())
    
    -- Return results for MCP
    return runner:getResults()
end

-- Run the tests
return main()
]]></ProtectedString>
