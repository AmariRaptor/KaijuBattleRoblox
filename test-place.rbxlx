				<ProtectedString name="Source"><![CDATA[--!strict
-- Test utilities for Kaiju Battle tests

local TestUtils = {}

-- Create a mock player
function TestUtils.createMockPlayer(name, userId)
    return {
        Name = name or "TestPlayer",
        UserId = userId or 12345,
        ClassName = "Player",
        
        -- Mock methods
        GetAttribute = function() return nil end,
        SetAttribute = function() end,
        GetAttributes = function() return {} end,
        GetAttributeChangedSignal = function() return { Connect = function() return {} end } end,
    }
end

-- Create a mock character
function TestUtils.createMockCharacter(name)
    local humanoid = {
        Health = 100,
        MaxHealth = 100,
        ClassName = "Humanoid",
        
        -- Mock methods
        TakeDamage = function(self, amount)
            self.Health = math.max(0, self.Health - amount)
            return self.Health
        end,
        
        -- Mock events
        Died = Instance.new("BindableEvent"),
        DiedEvent = Instance.new("BindableEvent"),
    }
    
    local character = {
        Name = name or "TestCharacter",
        ClassName = "Model",
        Humanoid = humanoid,
        
        -- Mock methods
        FindFirstChild = function(self, name)
            if name == "Humanoid" then
                return self.Humanoid
            end
            return nil
        end,
        
        FindFirstChildOfClass = function(self, className)
            if className == "Humanoid" then
                return self.Humanoid
            end
            return nil
        end,
        
        IsA = function(_, className)
            return className == "Model"
        end
    }
    
    -- Set up parent references
    humanoid.Parent = character
    
    return character
end

-- Assertion helpers
function TestUtils.assert(condition, message)
    if not condition then
        error(message or "Assertion failed", 2)
    end
end

function TestUtils.assertEquals(actual, expected, message)
    message = message or string.format("Expected %s, got %s", tostring(expected), tostring(actual))
    TestUtils.assert(actual == expected, message)
end

function TestUtils.assertNotEquals(actual, notExpected, message)
    message = message or string.format("Expected not %s, but got it", tostring(notExpected))
    TestUtils.assert(actual ~= notExpected, message)
end

function TestUtils.assertThrows(func, expectedError)
    local success, err = pcall(func)
    if success then
        error("Expected error but got none", 2)
    end
    if expectedError and not tostring(err):find(expectedError, 1, true) then
        error(string.format("Expected error containing '%s' but got: %s", expectedError, tostring(err)), 2)
    end
    return err
end

return TestUtils
]]></ProtectedString>
