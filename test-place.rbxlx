					<ProtectedString name="Source"><![CDATA[--!strict
-- Consolidated test runner for simplified tests

local TestRunner = {}

-- Test results tracking
TestRunner.results = {}
TestRunner.testCount = 0
TestRunner.passCount = 0
TestRunner.failCount = 0

-- Run a single test module
function TestRunner:runTest(moduleScript)
    local testName = moduleScript.Name
    self:log("\n" .. string.rep("=", 50))
    self:log("Running test: " .. testName)
    self:log(string.rep("=", 50))
    
    local success, testFunc = pcall(require, moduleScript)
    
    if not success then
        self:logResult(false, testName .. " - Failed to load: " .. tostring(testFunc))
        return false
    end
    
    if type(testFunc) ~= "function" then
        self:logResult(false, testName .. " - Module did not return a test function")
        return false
    end
    
    -- Run the test function
    local testSuccess, testResult = pcall(testFunc)
    
    if not testSuccess then
        self:logResult(false, testName .. " - Test error: " .. tostring(testResult))
        return false
    end
    
    -- Check if test returned a table of results
    if type(testResult) == "table" then
        local allPassed = true
        for _, result in ipairs(testResult) do
            -- Check if the result indicates pass or fail
            if type(result) == "string" then
                local passed = result:sub(1, 1) == "✅"
                if not passed then
                    allPassed = false
                end
                self:log("  " .. result)
            end
        end
        
        if allPassed then
            self:logResult(true, testName .. " - All tests passed")
            return true
        else
            self:logResult(false, testName .. " - Some tests failed")
            return false
        end
    else
        -- Simple pass/fail based on test function success
        self:logResult(testSuccess, testName .. " - " .. tostring(testResult or "Completed"))
        return testSuccess
    end
end

-- Log a test result
function TestRunner:logResult(success, message)
    self.testCount = self.testCount + 1
    if success then
        self.passCount = self.passCount + 1
        self:log("✅ " .. message)
    else
        self.failCount = self.failCount + 1
        self:log("❌ " .. message)
    end
end

-- Log a message
function TestRunner:log(message)
    table.insert(self.results, message)
    print(message)
end

-- Get the test summary
function TestRunner:getSummary()
    local summary = {}
    table.insert(summary, "\n" .. string.rep("=", 50))
    table.insert(summary, "TEST SUMMARY")
    table.insert(summary, string.rep("=", 50))
    table.insert(summary, string.format("Total tests: %d", self.testCount))
    table.insert(summary, string.format("✅ Passed: %d", self.passCount))
    table.insert(summary, string.format("❌ Failed: %d", self.failCount))
    table.insert(summary, string.rep("=", 50))
    
    return table.concat(summary, "\n")
end

-- Get all test results
function TestRunner:getResults()
    local allResults = {}
    
    -- Add individual test results
    for _, result in ipairs(self.results) do
        table.insert(allResults, result)
    end
    
    -- Add summary
    table.insert(allResults, self:getSummary())
    
    return allResults
end

return TestRunner
]]></ProtectedString>
