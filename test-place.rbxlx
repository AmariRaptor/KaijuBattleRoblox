												<ProtectedString name="Source"><![CDATA[--Assistant API

local moving = false
wait (0.25)
local moving1 = 1
local assistant = script.Parent.Parent.Parent.Parent.Parent.Parent.Parent.Parent.Parent.API.Assistant --Link this to API.
local activatedname = "Search" --Your services name
local outputtext = assistant.OutputResult
local result = ""

script.Parent.AssistantButton.MouseButton1Click:Connect(function()
	if moving1 == 1 then
		if assistant.Activated.Value == false then
			moving1 = 2
			assistant.InputName.Value = activatedname
			assistant.Activated.Value = true
		end
	end
end)

outputtext:GetPropertyChangedSignal("Value"):Connect(function()
	if moving1 == 2 then
		moving1 = 3
		game:GetService("TweenService"):Create(script.Parent.Input,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 1}):Play()
		wait (0.25)
		result = assistant.OutputResult.Value
		script.Parent.Input.Text = result
		game:GetService("TweenService"):Create(script.Parent.Input,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 0}):Play()
		wait (0.125)
		assistant.InputText.Value = ""
		assistant.InputName.Value = ""
		assistant.OutputResult.Value = ""
		assistant.Activated.Value = false
		wait (0.125)
		moving1 = 1
	end
end)

script.Parent.EnterButton.MouseButton1Click:Connect(function()
	if moving == false then
		moving = true --Put this before to prevent overlaping UIs
		game:GetService("TweenService"):Create(script.Parent.Input,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 1}):Play()
		wait (0.25)
		script.Parent.Input.Text = "Start talking"
		game:GetService("TweenService"):Create(script.Parent.Input,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 0}):Play()
		
		--Add your scripts here, to connect to the API fully, make sure to add = result to get whatever you needed to type in.
		
		for i,v in pairs(script.Parent.Parent.Parent.Sites:GetChildren()) do
			if v:IsA("Folder") then
				if v.SiteLink.Value == result then
					local loading = script.Parent.Parent.Parent.SiteLoading
					loading.Visible = true
					game:GetService("TweenService"):Create(loading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 0}):Play()
					wait(0.25)
					for i,v in pairs(script.Parent.Parent.Parent.Sites:GetChildren()) do
						if v.Name == "Site" then
							v.Site.Visible = false
						elseif v.Name == "Dashboard" then
							v.Dashboard.Visible = false
						end
					end
					if v.SiteLink.Value == "v.dashboard" then
						script.Parent.Parent.SiteLinkBackground.SiteLink.Text = "Dashboard"
						v.Dashboard.Visible = true
					else
						script.Parent.Parent.SiteLinkBackground.SiteLink.Text = v.SiteLink.Value
						v.Site.Visible = true
					end
					game:GetService("TweenService"):Create(loading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 1}):Play()
					wait(0.25)
					loading.Visible = false
				end
			end
		end
		
		--Add your scripts above, to connect to the API fully, make sure to add = result to get whatever you needed to type in.
		
		result = ""
		wait (0.25) --Put this after to confirm UI changes
		moving = false --Put this after to prevent overlaping UIs
	end
end)

--Assistant API by Vanilla

script.Parent.DashButton.MouseButton1Click:Connect(function()
	if moving == false then
		moving = true
		result = "v.dashboard"
		
		for i,v in pairs(script.Parent.Parent.Parent.Sites:GetChildren()) do
			if v:IsA("Folder") then
				if v.SiteLink.Value == result then
					local loading = script.Parent.Parent.Parent.SiteLoading
					loading.Visible = true
					game:GetService("TweenService"):Create(loading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 0}):Play()
					wait(0.25)
					for i,v in pairs(script.Parent.Parent.Parent.Sites:GetChildren()) do
						if v.Name == "Site" then
							v.Site.Visible = false
						elseif v.Name == "Dashboard" then
							v.Dashboard.Visible = false
						end
					end
					if v.SiteLink.Value == "v.dashboard" then
						script.Parent.Parent.SiteLinkBackground.SiteLink.Text = "Dashboard"
						v.Dashboard.Visible = true
					else
						script.Parent.Parent.SiteLinkBackground.SiteLink.Text = v.SiteLink.Value
						v.Site.Visible = true
					end
					game:GetService("TweenService"):Create(loading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 1}):Play()
					wait(0.25)
					loading.Visible = false
				end
			end
		end
		
		result = ""
		wait (0.25)
		moving = false
	end
end)]]></ProtectedString>
