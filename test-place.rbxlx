					<ProtectedString name="Source"><![CDATA[--!strict

-- BuildingSystem.server.luau
-- Handles all building-related functionality in the game

-- Services
local _ReplicatedStorage = game:GetService("ReplicatedStorage")
local _ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")

-- Type Definitions
type ModelWithPrimaryPart = Model & {
    PrimaryPart: BasePart,
    GetPrimaryPartCFrame: (self: ModelWithPrimaryPart) -> CFrame
}

type Building = {
    id: string,
    model: ModelWithPrimaryPart,
    buildingType: string,
    health: number,
    maxHealth: number,
    owner: Player,
    position: Vector3,
    isDestroyed: boolean,
    lastDamageTime: number,
    lastRepairTime: number,
    effects: {[string]: boolean},
    
    update: (self: Building, deltaTime: number) -> (),
    destroy: (self: Building) -> (),
    repair: (self: Building, amount: number) -> (),
    damage: (self: Building, amount: number) -> (),
    getHealthPercentage: (self: Building) -> number,
    addEffect: (self: Building, effectName: string) -> (),
    removeEffect: (self: Building, effectName: string) -> (),
    hasEffect: (self: Building, effectName: string) -> boolean
}

type BuildingType = {
    HEALTH: number,
    SIZE: Vector3,
    DAMAGE: number,
    REPAIR_RATE: number,
    EFFECTS: {[string]: boolean},
    create: (self: any, building: ModelWithPrimaryPart) -> Building
}

-- Main BuildingSystem module
type BuildingSystem = {
    buildings: {[string]: Building},
    BUILDING_TYPES: {[string]: {
        HEALTH: number,
        SIZE: Vector3,
        DAMAGE: number,
        REPAIR_RATE: number,
        EFFECTS: {[string]: boolean},
        create: (self: any, model: ModelWithPrimaryPart) -> Building
    }},
    init: (self: BuildingSystem) -> (),
    createBuilding: (self: BuildingSystem, buildingType: string, position: Vector3, owner: Player) -> Building?,
    updateAll: (self: BuildingSystem, deltaTime: number) -> (),
    _createBuildingModel: (self: BuildingSystem, buildingType: string, position: Vector3) -> ModelWithPrimaryPart,
    _applyBuildingEffects: (self: BuildingSystem, model: ModelWithPrimaryPart, effects: {[string]: boolean}) -> ()
}

local BuildingSystemImpl = {
    buildings = {},
    BUILDING_TYPES = {
        SKYSCRAPER = {
            HEALTH = 200,
            SIZE = Vector3.new(10, 50, 10),
            DAMAGE = 5,
            REPAIR_RATE = 2,
            EFFECTS = {
                SMOKE = true,
                LIGHTS = true
            },
            create = function(self: any, buildingModel: ModelWithPrimaryPart): Building
                local buildingObj: Building = {
                    id = buildingModel:GetFullName(),
                    model = buildingModel,
                    buildingType = "SKYSCRAPER",
                    health = self.HEALTH,
                    maxHealth = self.HEALTH,
                    owner = Players:GetPlayerFromCharacter(buildingModel.Parent) or error("Building must be owned by a player"),
                    position = buildingModel:GetPrimaryPartCFrame().Position,
                    isDestroyed = false,
                    lastDamageTime = 0,
                    lastRepairTime = 0,
                    effects = {},
                    
                    update = function(self: Building, deltaTime: number) end,
                    
                    destroy = function(self: Building)
                        if self.isDestroyed then return end
                        self.isDestroyed = true
                        
                        local explosion = Instance.new("Explosion")
                        explosion.Position = self.position
                        explosion.BlastRadius = 20
                        explosion.BlastPressure = 500000
                        explosion.Parent = workspace
                        
                        self.model:Destroy()
                    end,
                    
                    repair = function(self: Building, amount: number)
                        if self.isDestroyed then return end
                        self.health = math.min(self.health + amount, self.maxHealth)
                        self.lastRepairTime = tick()
                    end,
                    
                    damage = function(self: Building, amount: number)
                        if self.isDestroyed then return end
                        self.health = math.max(0, self.health - amount)
                        self.lastDamageTime = tick()
                        
                        if self.health <= 0 then
                            self:destroy()
                        end
                    end,
                    
                    getHealthPercentage = function(self: Building): number
                        return (self.health / self.maxHealth) * 100
                    end,
                    
                    addEffect = function(self: Building, effectName: string)
                        self.effects[effectName] = true
                    end,
                    
                    removeEffect = function(self: Building, effectName: string)
                        self.effects[effectName] = nil
                    end,
                    
                    hasEffect = function(self: Building, effectName: string): boolean
                        return self.effects[effectName] == true
                    end
                }
                
                return buildingObj
            end
        },
        
        HOSPITAL = {
            HEALTH = 150,
            SIZE = Vector3.new(20, 15, 20),
            DAMAGE = 0,
            REPAIR_RATE = 5,
            EFFECTS = {
                LIGHTS = true,
                HEALING_AURA = true
            },
            create = function(self: any, buildingModel: ModelWithPrimaryPart): Building
                -- Create base building using SKYSCRAPER as template
                local baseBuilding = self.BUILDING_TYPES.SKYSCRAPER
                local buildingObj = baseBuilding.create(baseBuilding, buildingModel)
                buildingObj.buildingType = "HOSPITAL"
                buildingObj.maxHealth = self.HEALTH
                buildingObj.health = self.HEALTH
                
                -- Add cross sign
                local cross = Instance.new("Part")
                cross.Size = Vector3.new(5, 1, 5)
                cross.Position = buildingModel.PrimaryPart.Position + Vector3.new(0, 15, 0)
                cross.BrickColor = BrickColor.new("Bright red")
                cross.Anchored = true
                cross.CanCollide = false
                cross.Parent = buildingModel
                
                -- Add medical supplies
                for i = -1, 1, 2 do
                    local supply = Instance.new("Part")
                    supply.Size = Vector3.new(3, 1, 3)
                    supply.Position = buildingModel.PrimaryPart.Position + Vector3.new(i * 5, 5, 0)
                    supply.BrickColor = BrickColor.new("Bright blue")
                    supply.Anchored = true
                    supply.CanCollide = false
                    supply.Parent = buildingModel
                end
                
                return buildingObj :: Building
            end
        },
        
        -- Add more building types here following the same pattern
        -- Example:
        -- FACTORY = {
        --     HEALTH = 300,
        --     SIZE = Vector3.new(30, 20, 30),
        --     DAMAGE = 10,
        --     REPAIR_RATE = 3,
        --     EFFECTS = {
        --         SMOKE = true,
        --         LIGHTS = true
        --     },
        --     create = function(self: any, buildingModel: ModelWithPrimaryPart): Building
        --         local baseBuilding = BuildingSystemImpl.BUILDING_TYPES.SKYSCRAPER
        --         local buildingObj = baseBuilding.create(baseBuilding, buildingModel)
        --         buildingObj.buildingType = "FACTORY"
        --         -- Custom factory setup here
        --         return buildingObj :: Building
        --     end
        -- }
    }
}

-- Initialize the BuildingSystem
function BuildingSystemImpl:init()
    self.buildings = {}
    
    -- Ensure Buildings folder exists
    local buildingsFolder = workspace:FindFirstChild("Buildings")
    if not buildingsFolder then
        buildingsFolder = Instance.new("Folder")
        buildingsFolder.Name = "Buildings"
        buildingsFolder.Parent = workspace
    end
    
    print("BuildingSystem initialized")
end

-- Create a new building
function BuildingSystemImpl:createBuilding(buildingType: string, position: Vector3, owner: Player): Building?
    local buildingTypeConfig = self.BUILDING_TYPES[buildingType]
    if not buildingTypeConfig then
        warn("Invalid building type:", buildingType)
        return nil
    end
    
    -- Create the building model
    local buildingModel = self:_createBuildingModel(buildingType, position)
    
    -- Create the building object
    local building = buildingTypeConfig.create(buildingTypeConfig, buildingModel)
    
    -- Apply building effects
    self:_applyBuildingEffects(buildingModel, buildingTypeConfig.EFFECTS)
    
    -- Store the building
    self.buildings[building.id] = building
    
    -- Set up destruction handler
    buildingModel.Destroying:Connect(function()
        self.buildings[building.id] = nil
    end)
    
    return building
end

-- Internal: Create a building model
function BuildingSystem:_createBuildingModel(buildingType: string, position: Vector3): ModelWithPrimaryPart
    local buildingConfig = self.BUILDING_TYPES[buildingType]
    if not buildingConfig then
        error("Invalid building type: " .. tostring(buildingType))
    end
    
    local model = Instance.new("Model")
    local primaryPart = Instance.new("Part")
    
    -- Configure the primary part
    primaryPart.Name = "PrimaryPart"
    primaryPart.Size = buildingConfig.SIZE
    primaryPart.Position = position
    primaryPart.Anchored = true
    primaryPart.CanCollide = true
    primaryPart.Parent = model
    
    -- Set the primary part
    model.PrimaryPart = primaryPart
    
    -- Add to workspace
    local buildingsFolder = workspace:FindFirstChild("Buildings") or Instance.new("Folder")
    buildingsFolder.Name = "Buildings"
    buildingsFolder.Parent = workspace
    model.Parent = buildingsFolder
    
    -- Set model name
    model.Name = buildingType .. "_" .. tostring(os.time())
    
    return model :: ModelWithPrimaryPart
end

-- Internal: Apply visual effects to a building
function BuildingSystem:_applyBuildingEffects(building: ModelWithPrimaryPart, effects: {[string]: boolean})
    for effectName, enabled in pairs(effects) do
        if not enabled then continue end
        
        if effectName == "SMOKE" then
            local smoke = Instance.new("Smoke")
            smoke.Color = Color3.fromRGB(200, 200, 200)
            smoke.Opacity = 0.5
            smoke.RiseVelocity = 5
            smoke.Size = 5
            smoke.Parent = building.PrimaryPart
        elseif effectName == "LIGHTS" then
            local light = Instance.new("PointLight")
            light.Brightness = 1
            light.Range = 20
            light.Color = Color3.fromRGB(255, 255, 200)
            light.Parent = building.PrimaryPart
        elseif effectName == "HEALING_AURA" then
            -- Add healing aura effect
            local aura = Instance.new("ParticleEmitter")
            aura.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 255, 200))
            })
            aura.LightEmission = 0.8
            aura.LightInfluence = 0
            aura.Size = NumberSequence.new(2)
            aura.Texture = "rbxassetid://296874871"
            aura.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.5),
                NumberSequenceKeypoint.new(1, 1)
            })
            aura.Lifetime = NumberRange.new(1, 2)
            aura.Rate = 10
            aura.Speed = NumberRange.new(2)
            aura.SpreadAngle = Vector2.new(0, 180)
            aura.Parent = building.PrimaryPart
        end
    end
end

return BuildingSystemImpl
]]></ProtectedString>
