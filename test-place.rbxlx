-- Simplified CharacterSystem test with proper mocks

local function createMockInstance(className, props)
    local mock = {
        ClassName = className,
        Name = props.Name or "Mock" .. className,
        Parent = nil
    }
    
    -- Add properties
    for k, v in pairs(props) do
        if k ~= "Name" and k ~= "ClassName" then
            mock[k] = v
        end
    end
    
    -- Mock FindFirstChild
    mock.FindFirstChild = function(self, name)
        return self[name]
    end
    
    -- Mock IsA
    mock.IsA = function(self, className)
        return self.ClassName == className
    end
    
    return setmetatable(mock, {
        __index = function(t, k)
            -- Allow accessing properties with dot notation
            return rawget(t, k)
        end
    })
end

local function runTests()
    local results = {}
    
    -- Mock CharacterSystem
    local CharacterSystem = {
        CLASS_ATTRIBUTES = {
            Kaiju = { MaxHealth = 500 },
            Guardian = { MaxHealth = 200 },
            Engineer = { MaxHealth = 150 }
        },
        
        onCharacterAdded = function(character)
            local player = character:FindFirstChild("Player")
            if not player then return false end
            
            local humanoid = character:FindFirstChild("Humanoid")
            if not humanoid then return false end
            
            local playerClass = player:FindFirstChild("PlayerClass")
            if not playerClass or not playerClass:IsA("StringValue") then return false end
            
            local attributes = CharacterSystem.CLASS_ATTRIBUTES[playerClass.Value]
            if not attributes then return false end
            
            humanoid.MaxHealth = attributes.MaxHealth
            humanoid.Health = attributes.MaxHealth
            
            return true
        end
    }
    
    -- Test onCharacterAdded with Kaiju class
    do
        local testPlayer = createMockInstance("Player", {
            Name = "TestPlayer",
            PlayerClass = createMockInstance("StringValue", {
                Name = "PlayerClass",
                Value = "Kaiju"
            })
        })
        
        local testCharacter = createMockInstance("Model", {
            Name = "TestCharacter",
            Humanoid = createMockInstance("Humanoid", {
                Health = 0,
                MaxHealth = 100
            }),
            Player = testPlayer
        })
        
        -- Set up parent references
        testPlayer.Character = testCharacter
        testPlayer.PlayerClass.Parent = testPlayer
        
        local success = CharacterSystem.onCharacterAdded(testCharacter)
        if not success then
            table.insert(results, "❌ onCharacterAdded: Failed to process character")
        else
            if testCharacter.Humanoid.MaxHealth ~= 500 then
                table.insert(results, "❌ onCharacterAdded: Incorrect max health: " .. tostring(testCharacter.Humanoid.MaxHealth))
            else
                table.insert(results, "✅ onCharacterAdded: Correct max health for Kaiju")
            end
            
            if testCharacter.Humanoid.Health ~= 500 then
                table.insert(results, "❌ onCharacterAdded: Incorrect health: " .. tostring(testCharacter.Humanoid.Health))
            else
                table.insert(results, "✅ onCharacterAdded: Correct health for Kaiju")
            end
        end
    end
    
    -- Test onCharacterAdded with invalid class
    do
        local testPlayer = createMockInstance("Player", {
            Name = "TestPlayer",
            PlayerClass = createMockInstance("StringValue", {
                Name = "PlayerClass",
                Value = "InvalidClass"
            })
        })
        
        local testCharacter = createMockInstance("Model", {
            Name = "TestCharacter",
            Humanoid = createMockInstance("Humanoid", {
                Health = 100,
                MaxHealth = 100
            }),
            Player = testPlayer
        })
        
        -- Set up parent references
        testPlayer.Character = testCharacter
        testPlayer.PlayerClass.Parent = testPlayer
        
        local success = CharacterSystem.onCharacterAdded(testCharacter)
        if success then
            table.insert(results, "❌ onCharacterAdded: Should fail with invalid class")
        else
            table.insert(results, "✅ onCharacterAdded: Correctly handles invalid class")
        end
    end
    
    return results
end

return runTests
]]></ProtectedString>
