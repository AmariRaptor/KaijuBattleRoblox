				<ProtectedString name="Source"><![CDATA[--!strict
-- Simple Test Runner for MCP environment

local SimpleTestRunner = {}

-- Configuration
local CONFIG = {
    VERBOSE = true,  -- Enable detailed logging
    TIMEOUT = 10,    -- Timeout in seconds per test
}

-- Log a message
local function log(message, level)
    level = level or "INFO"
    print(string.format("[%s] %s", level, tostring(message)))
end

-- Run a single test module
function SimpleTestRunner.runTest(moduleScript)
    local startTime = os.clock()
    local testName = moduleScript.Name
    
    log(string.format("Running test: %s", testName))
    
    -- Load the test module
    local success, testFunc = pcall(require, moduleScript)
    if not success then
        log(string.format("❌ Failed to load test: %s", testFunc), "ERROR")
        return false, {error = testFunc}
    end
    
    -- Check if the module returned a function
    if type(testFunc) ~= "function" then
        local msg = "Test module did not return a function"
        log(string.format("❌ %s: %s", testName, msg), "ERROR")
        return false, {error = msg}
    end
    
    -- Run the test function
    local testSuccess, testResults = pcall(testFunc)
    local duration = os.clock() - startTime
    
    -- Process results
    if not testSuccess then
        log(string.format("❌ Test failed: %s (%.3fs)", testResults, duration), "ERROR")
        return false, {error = testResults, duration = duration}
    end
    
    -- Handle different return types
    if type(testResults) == "table" then
        local passed = 0
        local failed = 0
        
        for _, result in ipairs(testResults) do
            if type(result) == "string" then
                if result:sub(1, 1) == "✅" then
                    passed = passed + 1
                    log("  " .. result, "SUCCESS")
                elseif result:sub(1, 1) == "❌" then
                    failed = failed + 1
                    log("  " .. result, "ERROR")
                else
                    log("  " .. result, "INFO")
                end
            end
        end
        
        if failed == 0 then
            log(string.format("✅ Test passed: %s (%.3fs, %d assertions)", 
                testName, duration, passed), "SUCCESS")
            return true, {passed = passed, failed = 0, duration = duration}
        else
            log(string.format("❌ Test failed: %s (%.3fs, %d/%d passed)", 
                testName, duration, passed, passed + failed), "ERROR")
            return false, {passed = passed, failed = failed, duration = duration}
        end
    else
        log(string.format("ℹ️ Test completed: %s (%.3fs, no assertions)", 
            testName, duration), "INFO")
        return true, {passed = 0, failed = 0, duration = duration}
    end
end

-- Find and run all test files
function SimpleTestRunner.runAllTests()
    local totalTests = 0
    local passedTests = 0
    local failedTests = 0
    local totalAssertions = 0
    local failedAssertions = 0
    local startTime = os.clock()
    
    log("\n" .. string.rep("=", 50))
    log("STARTING TEST RUN")
    log(string.rep("=", 50))
    
    -- Find all test files
    local function findTests(folder, tests)
        tests = tests or {}
        
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Folder") then
                findTests(item, tests)
            elseif item:IsA("ModuleScript") and 
                   (item.Name:match("%.spec$") or 
                    item.Name:match("%.test$") or
                    item.Name:match("Test$")) then
                table.insert(tests, item)
            end
        end
        
        return tests
    end
    
    local testFiles = findTests(ServerStorage)
    
    if #testFiles == 0 then
        log("No test files found!", "WARNING")
        return false
    end
    
    log(string.format("Found %d test files:", #testFiles))
    for i, file in ipairs(testFiles) do
        log(string.format("  %d. %s", i, file:GetFullName()))
    end
    
    -- Run all tests
    for _, testFile in ipairs(testFiles) do
        totalTests = totalTests + 1
        local success, results = SimpleTestRunner.runTest(testFile)
        
        if success then
            passedTests = passedTests + 1
            totalAssertions = totalAssertions + (results.passed or 0)
        else
            failedTests = failedTests + 1
            totalAssertions = totalAssertions + (results.passed or 0)
            failedAssertions = failedAssertions + (results.failed or 1)
        end
    end
    
    -- Print summary
    local duration = os.clock() - startTime
    
    log("\n" .. string.rep("=", 50))
    log("TEST SUMMARY")
    log(string.rep("=", 50))
    log(string.format("Total tests:  %d", totalTests))
    log(string.format("Tests passed: %d", passedTests))
    log(string.format("Tests failed: %d", failedTests))
    log(string.format("Total assertions: %d", totalAssertions))
    log(string.format("Failed assertions: %d", failedAssertions))
    log(string.format("Duration: %.3f seconds", duration))
    log(string.rep("=", 50))
    
    if failedTests == 0 then
        log("🎉 ALL TESTS PASSED!", "SUCCESS")
    else
        log(string.format("❌ %d TEST(S) FAILED!", failedTests), "ERROR")
    end
    log(string.rep("=", 50) .. "\n")
    
    return failedTests == 0
end

return SimpleTestRunner
]]></ProtectedString>
