-- Auto-run test script
-- Place this in ServerScriptService to run tests automatically when the game starts

local TestRunner = require(game:GetService("ServerStorage").TestRunner)

-- Run tests when the game starts
game:GetService("Players").PlayerAdded:Connect(function(player)
    if player.UserId == 1 then  -- Only run for the first player (usually the developer)
        TestRunner:runAllTests()
    end
end)

-- Also run tests when this script is required
return TestRunner:runAllTests()
