    return {}
end

function MockBuildingSystem:_canPlaceBuilding(player: any, cframe: CFrame, size: Vector3): (boolean, string)
    return true, ""
end

local _BuildingSystem = MockBuildingSystem

return function()
    -- Mock dependencies
    local function createMockInstance(className: string)
        local mock = {
            Name = className,
            Parent = nil,
            FindFirstChild = function(_, name: string)
                return nil
            end,
            FindFirstChildOfClass = function(_, className: string)
                return nil
            }
        }
        return mock
    end
    
    -- Mock model creation
    local function createMockModel()
        local model = {}
        model.Name = "MockModel"
