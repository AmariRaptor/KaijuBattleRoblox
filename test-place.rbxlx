					<ProtectedString name="Source"><![CDATA[--!strict
-- Simplified ScoringSystem test

local ScoringSystem = {}

-- Mock scoring data
ScoringSystem.scores = {}

-- Add score for a player
function ScoringSystem:addScore(player, points)
    if not self.scores[player.Name] then
        self.scores[player.Name] = 0
    end
    self.scores[player.Name] = self.scores[player.Name] + points
    return self.scores[player.Name]
end

-- Get score for a player
function ScoringSystem:getScore(player)
    return self.scores[player.Name] or 0
end

-- Reset all scores
function ScoringSystem:resetScores()
    self.scores = {}
end

-- Test runner function
local function runTests()
    local results = {}
    local testCount = 0
    local passCount = 0
    
    local function runTest(name, testFunc)
        testCount = testCount + 1
        local success, err = pcall(testFunc)
        if success then
            passCount = passCount + 1
            table.insert(results, "✅ " .. name)
        else
            table.insert(results, "❌ " .. name .. " - " .. tostring(err))
        end
    end
    
    -- Mock player
    local function createMockPlayer(name)
        return {
            Name = name,
            ClassName = "Player"
        }
    end
    
    -- Test 1: Add score to a player
    runTest("Add score to player", function()
        local player = createMockPlayer("TestPlayer1")
        local score = ScoringSystem:addScore(player, 100)
        assert(score == 100, "Expected score to be 100, got " .. tostring(score))
        
        local currentScore = ScoringSystem:getScore(player)
        assert(currentScore == 100, "Expected getScore to return 100, got " .. tostring(currentScore))
    end)
    
    -- Test 2: Add multiple scores to same player
    runTest("Add multiple scores to same player", function()
        local player = createMockPlayer("TestPlayer2")
        ScoringSystem:addScore(player, 50)
        ScoringSystem:addScore(player, 75)
        local score = ScoringSystem:getScore(player)
        assert(score == 125, "Expected score to be 125, got " .. tostring(score))
    end)
    
    -- Test 3: Reset scores
    runTest("Reset scores", function()
        local player = createMockPlayer("TestPlayer3")
        ScoringSystem:addScore(player, 200)
        ScoringSystem:resetScores()
        local score = ScoringSystem:getScore(player)
        assert(score == 0, "Expected score to be 0 after reset, got " .. tostring(score))
    end)
    
    -- Test 4: Get score for non-existent player
    runTest("Get score for non-existent player", function()
        local player = createMockPlayer("NonExistentPlayer")
        local score = ScoringSystem:getScore(player)
        assert(score == 0, "Expected score to be 0 for non-existent player, got " .. tostring(score))
    end)
    
    -- Add test summary
    table.insert(results, 1, string.format("\nTest Results: %d/%d tests passed\n======================", passCount, testCount))
    
    return results
end

return runTests
]]></ProtectedString>
