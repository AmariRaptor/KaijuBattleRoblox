					<ProtectedString name="Source"><![CDATA[--!strict
-- Fixed CharacterSystem test with proper structure

local CharacterSystem = {}

-- Class attributes
CharacterSystem.CLASS_ATTRIBUTES = {
    Kaiju = { MaxHealth = 500 },
    Guardian = { MaxHealth = 200 },
    Engineer = { MaxHealth = 150 }
}

function CharacterSystem:onCharacterAdded(character)
    local player = character:FindFirstChild("Player")
    if not player then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    local playerClass = player:FindFirstChild("PlayerClass")
    if not playerClass or not playerClass:IsA("StringValue") then return false end
    
    local attributes = self.CLASS_ATTRIBUTES[playerClass.Value]
    if not attributes then return false end
    
    humanoid.MaxHealth = attributes.MaxHealth
    humanoid.Health = attributes.MaxHealth
    
    return true
end

-- Test runner function
local function runTests()
    local results = {}
    local testCount = 0
    local passCount = 0
    
    local function runTest(name, testFunc)
        testCount = testCount + 1
        local success, err = pcall(testFunc)
        if success then
            passCount = passCount + 1
            table.insert(results, "✅ " .. name)
        else
            table.insert(results, "❌ " .. name .. " - " .. tostring(err))
        end
    end
    
    -- Mock instance creation
    local function createMockInstance(className, props)
        local mock = {
            ClassName = className,
            Name = props.Name or "Mock" .. className,
            Parent = nil
        }
        
        -- Add properties
        for k, v in pairs(props) do
            if k ~= "Name" and k ~= "ClassName" then
                mock[k] = v
            end
        end
        
        -- Mock FindFirstChild
        mock.FindFirstChild = function(self, name)
            return self[name]
        end
        
        -- Mock IsA
        mock.IsA = function(self, className)
            return self.ClassName == className
        end
        
        return setmetatable(mock, {
            __index = function(t, k)
                return rawget(t, k)
            end
        })
    end
    
    -- Test 1: Kaiju class should set max health to 500
    runTest("Kaiju class sets max health to 500", function()
        local testPlayer = createMockInstance("Player", {
            Name = "TestPlayer",
            PlayerClass = createMockInstance("StringValue", {
                Name = "PlayerClass",
                Value = "Kaiju"
            })
        })
        
        local testCharacter = createMockInstance("Model", {
            Name = "TestCharacter",
            Humanoid = createMockInstance("Humanoid", {
                Health = 0,
                MaxHealth = 100
            }),
            Player = testPlayer
        })
        
        testPlayer.Character = testCharacter
        testPlayer.PlayerClass.Parent = testPlayer
        
        local success = CharacterSystem:onCharacterAdded(testCharacter)
        assert(success, "onCharacterAdded should return true for valid character")
        assert(testCharacter.Humanoid.MaxHealth == 500, "Kaiju max health should be 500")
        assert(testCharacter.Humanoid.Health == 500, "Kaiju health should be set to max health")
    end)
    
    -- Test 2: Invalid class should return false
    runTest("Invalid class returns false", function()
        local testPlayer = createMockInstance("Player", {
            Name = "TestPlayer",
            PlayerClass = createMockInstance("StringValue", {
                Name = "PlayerClass",
                Value = "InvalidClass"
            })
        })
        
        local testCharacter = createMockInstance("Model", {
            Name = "TestCharacter",
            Humanoid = createMockInstance("Humanoid", {
                Health = 100,
                MaxHealth = 100
            }),
            Player = testPlayer
        })
        
        testPlayer.Character = testCharacter
        testPlayer.PlayerClass.Parent = testPlayer
        
        local success = CharacterSystem:onCharacterAdded(testCharacter)
        assert(not success, "onCharacterAdded should return false for invalid class")
    end)
    
    -- Add test summary
    table.insert(results, 1, string.format("\nTest Results: %d/%d tests passed\n======================", passCount, testCount))
    
    return results
end

return runTests
]]></ProtectedString>
