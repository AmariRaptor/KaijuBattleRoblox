				<ProtectedString name="Source"><![CDATA[--!strict

-- BuildingSystem.server.luau
-- Handles all building-related functionality in the game

-- Services (imported for potential future use)
local _ReplicatedStorage = game:GetService("ReplicatedStorage")
local _ServerStorage = game:GetService("ServerStorage")
local _Players = game:GetService("Players")

-- Type Definitions
type ModelWithPrimaryPart = Model & {
    PrimaryPart: BasePart,
    GetPrimaryPartCFrame: (self: ModelWithPrimaryPart) -> CFrame
}

type Building = {
    id: string,
    model: ModelWithPrimaryPart,
    buildingType: string,
    health: number,
    maxHealth: number,
    owner: Player,
    position: Vector3,
    isDestroyed: boolean,
    lastDamageTime: number,
    lastRepairTime: number,
    effects: {[string]: boolean},
    
    update: (self: Building, deltaTime: number) -> (),
    destroy: (self: Building) -> (),
    repair: (self: Building, amount: number) -> (),
    damage: (self: Building, amount: number) -> (),
    getHealthPercentage: (self: Building) -> number,
    addEffect: (self: Building, effectName: string) -> (),
    removeEffect: (self: Building, effectName: string) -> (),
    hasEffect: (self: Building, effectName: string) -> boolean
}

local BuildingSystem = {}
BuildingSystem.__index = BuildingSystem

-- Private implementation
local BuildingSystemPrivate = {}
BuildingSystemPrivate.__index = BuildingSystemPrivate

-- Building type definitions
local BUILDING_TYPES = {
    SKYSCRAPER = {
        HEALTH = 200,
        SIZE = Vector3.new(10, 50, 10),
        DAMAGE = 5,
        REPAIR_RATE = 2,
        EFFECTS = {
            SMOKE = true,
            LIGHTS = true
        }
    },
    HOSPITAL = {
        HEALTH = 150,
        SIZE = Vector3.new(20, 15, 20),
        DAMAGE = 0,
        REPAIR_RATE = 5,
        EFFECTS = {
            LIGHTS = true,
            HEALING_AURA = true
        }
    }
}

-- Create a new BuildingSystem instance
function BuildingSystem.new()
    local self = setmetatable({
        _buildings = {}
    }, BuildingSystemPrivate)
    
    -- Create Buildings folder if it doesn't exist
    if not workspace:FindFirstChild("Buildings") then
        local buildingsFolder = Instance.new("Folder")
        buildingsFolder.Name = "Buildings"
        buildingsFolder.Parent = workspace
    end
    
    return self
end

-- Initialize the BuildingSystem
function BuildingSystemPrivate:init()
    -- Initialization logic here
end

-- Create a new building
function BuildingSystemPrivate:createBuilding(buildingType: string, position: Vector3, owner: Player): Building?
    local buildingConfig = BUILDING_TYPES[buildingType]
    if not buildingConfig then
        warn("Invalid building type:", buildingType)
        return nil
    end
    
    -- Create the building model
    local buildingModel = self:_createBuildingModel(buildingType, position)
    
    -- Create the building object
    local building = self:_createBuildingObject(buildingType, buildingModel, buildingConfig, owner)
    
    -- Store the building
    self._buildings[building.id] = building
    
    -- Set up destruction handler
    buildingModel.Destroying:Connect(function()
        self._buildings[building.id] = nil
    end)
    
    return building
end

-- Internal: Create a building object
function BuildingSystemPrivate:_createBuildingObject(
    buildingType: string,
    model: ModelWithPrimaryPart,
    config: {[string]: any},
    owner: Player
): Building
    local buildingObj: Building = {
        id = model:GetFullName(),
        model = model,
        buildingType = buildingType,
        health = config.HEALTH,
        maxHealth = config.HEALTH,
        owner = owner,
        position = model:GetPrimaryPartCFrame().Position,
        isDestroyed = false,
        lastDamageTime = 0,
        lastRepairTime = 0,
        effects = {},
        
        update = function(self: Building, deltaTime: number) end,
        
        destroy = function(self: Building)
            if self.isDestroyed then return end
            self.isDestroyed = true
            
            local explosion = Instance.new("Explosion")
            explosion.Position = self.position
            explosion.BlastRadius = 20
            explosion.BlastPressure = 500000
            explosion.Parent = workspace
            
            self.model:Destroy()
        end,
        
        repair = function(self: Building, amount: number)
            if self.isDestroyed then return end
            self.health = math.min(self.health + amount, self.maxHealth)
            self.lastRepairTime = tick()
        end,
        
        damage = function(self: Building, amount: number)
            if self.isDestroyed then return end
            self.health = math.max(0, self.health - amount)
            self.lastDamageTime = tick()
            
            if self.health <= 0 then
                self:destroy()
            end
        end,
        
        getHealthPercentage = function(self: Building): number
            return (self.health / self.maxHealth) * 100
        end,
        
        addEffect = function(self: Building, effectName: string)
            self.effects[effectName] = true
        end,
        
        removeEffect = function(self: Building, effectName: string)
            self.effects[effectName] = nil
        end,
        
        hasEffect = function(self: Building, effectName: string): boolean
            return self.effects[effectName] == true
        end
    }
    
    -- Apply building effects
    self:_applyBuildingEffects(buildingObj, config.EFFECTS)
    
    return buildingObj
end

-- Internal: Create a building model
function BuildingSystemPrivate:_createBuildingModel(buildingType: string, position: Vector3): ModelWithPrimaryPart
    local buildingConfig = BUILDING_TYPES[buildingType]
    if not buildingConfig then
        error("Invalid building type: " .. tostring(buildingType))
    end
    
    local model = Instance.new("Model")
    local primaryPart = Instance.new("Part")
    
    -- Configure the primary part
    primaryPart.Name = "PrimaryPart"
    primaryPart.Size = buildingConfig.SIZE
    primaryPart.Position = position
    primaryPart.Anchored = true
    primaryPart.CanCollide = true
    primaryPart.Parent = model
    
    -- Set the primary part
    model.PrimaryPart = primaryPart
    
    -- Add to workspace
    local buildingsFolder = workspace:FindFirstChild("Buildings") or Instance.new("Folder")
    buildingsFolder.Name = "Buildings"
    buildingsFolder.Parent = workspace
    model.Parent = buildingsFolder
    
    -- Set model name
    model.Name = buildingType .. "_" .. tostring(os.time())
    
    return model :: ModelWithPrimaryPart
end

-- Internal: Apply visual effects to a building
function BuildingSystemPrivate:_applyBuildingEffects(building: Building, effects: {[string]: boolean})
    local model = building.model
    if not model.PrimaryPart then return end
    
    for effectName, enabled in pairs(effects) do
        if not enabled then continue end
        
        if effectName == "SMOKE" then
            local smoke = Instance.new("Smoke")
            smoke.Color = Color3.fromRGB(200, 200, 200)
            smoke.Opacity = 0.5
            smoke.RiseVelocity = 5
            smoke.Size = 5
            smoke.Parent = model.PrimaryPart
        elseif effectName == "LIGHTS" then
            local light = Instance.new("PointLight")
            light.Brightness = 1
            light.Range = 20
            light.Color = Color3.fromRGB(255, 255, 200)
            light.Parent = model.PrimaryPart
        elseif effectName == "HEALING_AURA" then
            local aura = Instance.new("ParticleEmitter")
            aura.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 255, 200))
            })
            aura.LightEmission = 0.8
            aura.LightInfluence = 0
            aura.Size = NumberSequence.new(2)
            aura.Texture = "rbxassetid://296874871"
            aura.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.5),
                NumberSequenceKeypoint.new(1, 1)
            })
            aura.Lifetime = NumberRange.new(1, 2)
            aura.Rate = 10
            aura.Speed = NumberRange.new(2)
            aura.SpreadAngle = Vector2.new(0, 180)
            aura.Parent = model.PrimaryPart
        end
    end
end

-- Public API
local PublicAPI = {}

function PublicAPI.new()
    return BuildingSystem.new()
end

function PublicAPI:createBuilding(buildingType: string, position: Vector3, owner: Player): Building?
    return self:createBuilding(buildingType, position, owner)
end

return PublicAPI
]]></ProtectedString>
