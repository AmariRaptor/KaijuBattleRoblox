									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<token name="RunContext">0</token>
									<string name="ScriptGuid">{86497498-6172-45F0-84C2-23CBD23D4D89}</string>
									<ProtectedString name="Source"><![CDATA[local drawing = false

function draw(x,y)
	local p = Instance.new("Frame")
	p.Size = UDim2.new(0,script.Parent.Tools.SizeV.Value,0,script.Parent.Tools.SizeV.Value)
	p.Position = UDim2.new(-0.05,x,-0.4,y)
	p.BorderSizePixel = 0
	p.BackgroundColor3 = script.Parent.Color.Value
	p.Parent = script.Parent.Folder
end

function onClicked(x,y)
	if script.Parent.Painting.Value == true then
		drawing = true
		draw(x,y)
	end
end

function moved(x,y)
	if drawing == true and script.Parent.Painting.Value == true then
		draw(x,y)
	end
end

function nonClicked()
	drawing = false
end

script.Parent.MouseButton1Down:connect(onClicked)
script.Parent.MouseButton1Up:connect(nonClicked)
script.Parent.MouseMoved:connect(moved)

]]></ProtectedString>
