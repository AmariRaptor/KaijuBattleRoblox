				<ProtectedString name="Source"><![CDATA[--!strict
-- Comprehensive Test Runner for Kaiju Battle
-- Place this module in ServerScriptService or require it from a Script

local TestRunner = {}

-- Configuration
local CONFIG = {
    VERBOSE = true,         -- Enable detailed logging
    STOP_ON_FAILURE = false, -- Stop tests after first failure
    TIMEOUT = 30,           -- Timeout in seconds per test file
    LOG_LEVEL = 2,          -- 1=Errors only, 2=Warnings, 3=Info, 4=Debug
}

-- Test results tracking
TestRunner.results = {
    totalTests = 0,
    passed = 0,
    failed = 0,
    testFiles = {},
    startTime = 0,
    endTime = 0,
    duration = 0
}

-- Logging functions
local function log(level, message, ...)
    if level > CONFIG.LOG_LEVEL then return end
    
    local prefix = ""
    if level == 1 then prefix = "[ERROR] "
    elseif level == 2 then prefix = "[WARN]  "
    elseif level == 3 then prefix = "[INFO]  "
    elseif level == 4 then prefix = "[DEBUG] " end
    
    print(prefix .. string.format(message, ...))
end

-- Find all test files in the project
function TestRunner:findTestFiles()
    local testFiles = {}
    
    local function scan(folder, path)
        for _, child in ipairs(folder:GetChildren()) do
            local childPath = path and (path .. "." .. child.Name) or child.Name
            
            if child:IsA("Folder") then
                scan(child, childPath)
            elseif child:IsA("ModuleScript") and 
                  (child.Name:match("%.spec$") or 
                   child.Name:match("%.test$") or
                   child.Name:match("Test$")) then
                table.insert(testFiles, {
                    instance = child,
                    path = childPath
                })
            end
        end
    end
    
    -- Search in common test locations
    local searchFolders = {
        ServerStorage:FindFirstChild("Tests"),
        ServerStorage:FindFirstChild("Test"),
        ServerStorage:FindFirstChild("TestEZ"),
        ServerStorage:FindFirstChild("Specs")
    }
    
    for _, folder in ipairs(searchFolders) do
        if folder and folder:IsA("Folder") then
            scan(folder, folder.Name)
        end
    end
    
    return testFiles
end

-- Run a single test file
function TestRunner:runTestFile(testFile)
    local startTime = os.clock()
    local testResult = {
        name = testFile.path,
        passed = false,
        assertions = {},
        error = nil,
        duration = 0
    }
    
    log(3, "Running test: %s", testFile.path)
    
    -- Run the test with a timeout
    local success, result = pcall(function()
        local testFunc = require(testFile.instance)
        if type(testFunc) ~= "function" then
            return { "❌ Test module did not return a function" }
        end
        
        local testSuccess, testResults = pcall(testFunc)
        if not testSuccess then
            return { "❌ Test error: " .. tostring(testResults) }
        end
        
        if type(testResults) == "table" then
            return testResults
        end
        
        return { "ℹ️ Test completed: " .. tostring(testResults) }
    end)
    
    -- Process results
    testResult.duration = os.clock() - startTime
    
    if not success then
        testResult.error = tostring(result)
        log(1, "❌ Test failed: %s - %s", testFile.path, testResult.error)
    else
        if type(result) == "table" then
            for _, line in ipairs(result) do
                table.insert(testResult.assertions, tostring(line))
                if line:sub(1, 1) == "❌" then
                    testResult.passed = false
                end
            end
        else
            table.insert(testResult.assertions, tostring(result))
        end
        
        -- If no assertions failed, mark as passed
        if #testResult.assertions == 0 or not testResult.error then
            testResult.passed = true
        end
        
        log(testResult.passed and 3 or 2, 
            "%s %s (%.3fs)", 
            testResult.passed and "✅" or "❌", 
            testFile.path, 
            testResult.duration)
    end
    
    -- Update global stats
    self.results.totalTests = self.results.totalTests + 1
    if testResult.passed then
        self.results.passed = self.results.passed + 1
    else
        self.results.failed = self.results.failed + 1
    end
    
    table.insert(self.results.testFiles, testResult)
    return testResult.passed
end

-- Run all tests
function TestRunner:runAllTests()
    self.results = {
        totalTests = 0,
        passed = 0,
        failed = 0,
        testFiles = {},
        startTime = os.clock(),
        endTime = 0,
        duration = 0
    }
    
    log(3, "\n" .. string.rep("=", 80))
    log(3, "STARTING TEST RUN")
    log(3, string.rep("=", 80))
    
    -- Find and run all test files
    local testFiles = self:findTestFiles()
    
    if #testFiles == 0 then
        log(2, "No test files found!")
        return false
    end
    
    log(3, "Found %d test files:", #testFiles)
    for i, file in ipairs(testFiles) do
        log(3, "  %d. %s", i, file.path)
    end
    
    -- Run each test file
    for _, testFile in ipairs(testFiles) do
        local success = self:runTestFile(testFile)
        if not success and CONFIG.STOP_ON_FAILURE then
            log(2, "Stopping tests due to failure in: %s", testFile.path)
            break
        end
    end
    
    -- Calculate final statistics
    self.results.endTime = os.clock()
    self.results.duration = self.results.endTime - self.results.startTime
    
    -- Print summary
    self:printSummary()
    
    return self.results.failed == 0
end

-- Print test summary
function TestRunner:printSummary()
    local results = self.results
    
    log(3, "\n" .. string.rep("=", 80))
    log(3, "TEST SUMMARY")
    log(3, string.rep("=", 80))
    log(3, "Total tests: %d", results.totalTests)
    log(3, "✅ Passed: %d", results.passed)
    log(3, "❌ Failed: %d", results.failed)
    log(3, "⏱️  Duration: %.3f seconds", results.duration)
    log(3, string.rep("=", 80))
    
    -- Print detailed results for failed tests
    if results.failed > 0 then
        log(2, "\nFAILED TESTS:")
        for _, test in ipairs(results.testFiles) do
            if not test.passed then
                log(2, "\n❌ %s (%.3fs)", test.name, test.duration)
                if test.error then
                    log(2, "  Error: %s", test.error)
                end
                for _, assertion in ipairs(test.assertions) do
                    log(2, "  %s", assertion)
                end
            end
        end
    end
    
    -- Final status
    if results.failed == 0 then
        log(3, "\n🎉 ALL TESTS PASSED!")
    else
        log(1, "\n❌ SOME TESTS FAILED!")
    end
    
    log(3, string.rep("=", 80) .. "\n")
end

-- Run tests when required
return TestRunner
]]></ProtectedString>
