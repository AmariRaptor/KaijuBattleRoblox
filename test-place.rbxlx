								<ProtectedString name="Source"><![CDATA[local directory = ""

if script.Parent.Parent.Parent.Parent.Parent.VanillaLinkOptions.Directory.Value ~= "" then
	if script.Parent.Parent.Parent.Parent.Parent.VanillaLinkOptions.Linked.Value == false then
		script.Parent.Transfer.Name = script.Parent.Parent.Parent.Parent.Parent.VanillaLinkOptions.Directory.Value
		for i,v in pairs(script.Parent:GetChildren()) do
			if v:IsA("Folder") then
				directory = v.Name
				v.Parent = game.ServerStorage
			end
		end
	end
end
wait (1)
directory = script.Parent.Parent.Parent.Parent.Parent.VanillaLinkOptions.Directory.Value
if script.Parent.Parent.Parent.Parent.Parent.VanillaLinkOptions.Directory.Value ~= "" then
	for i,v in pairs(game.ServerStorage[directory]:GetChildren()) do
		if v:IsA("ImageLabel") then
			v:Clone().Parent = script.Parent.Parent.Parent.SystemHome.SystemControls.SystemDashboard.UIPanel.Sites.Dashboard.Dashboard.DeviceControls
		end
	end
end]]></ProtectedString>
