								<ProtectedString name="Source"><![CDATA[wait (0.25)
local moving = false
local movesys = script.Parent.Parent.Parent.Parent.Parent.MovementSystem.MoveDetect

movesys:GetPropertyChangedSignal("Value"):Connect(function()
	if movesys.Value == true then
		if moving == false then
			moving = true
			script.Parent.Visible = true
			script.Parent:TweenPosition(UDim2.new(0.8,0,0.05,0), "Out", "Quint", 0.5, true)
			wait (2)
			script.Parent:TweenPosition(UDim2.new(0.8,0,-0.1,0), "Out", "Quint", 0.5, true)
			wait (0.5)
			script.Parent.Visible = false
			wait (0.25)
			moving = false
		end
	end
end)]]></ProtectedString>
