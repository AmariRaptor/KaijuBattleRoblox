-- Simplified KaijuSystem test

local function runTests()
    local results = {}
    
    -- Mock KaijuSystem
    local KaijuSystem = {}
    
    function KaijuSystem:spawnKaiju(player)
        local kaiju = {
            Name = "Kaiju",
            Humanoid = {
                Health = 500,
                MaxHealth = 500,
                Parent = nil
            },
            Parent = nil
        }
        
        if player and player.Character then
            kaiju.Parent = player.Character
        end
        
        if kaiju.Humanoid then
            kaiju.Humanoid.Parent = kaiju
        end
        
        return kaiju
    end
    
    function KaijuSystem:setupAbilities(kaiju)
        local abilities = {
            energyBeam = { ClassName = "RemoteEvent" },
            roar = { ClassName = "Sound" }
        }
        
        for name, ability in pairs(abilities) do
            kaiju[name] = ability
        end
        
        return abilities
    end
    
    -- Test spawnKaiju
    do
        local testPlayer = {
            Name = "TestPlayer",
            Character = { Name = "TestCharacter" }
        }
        
        local kaiju = KaijuSystem:spawnKaiju(testPlayer)
        if not kaiju then
            table.insert(results, "❌ spawnKaiju: Failed to create kaiju")
        else
            if kaiju.Name ~= "Kaiju" then
                table.insert(results, "❌ spawnKaiju: Incorrect name: " .. tostring(kaiju.Name))
            else
                table.insert(results, "✅ spawnKaiju: Created kaiju with correct name")
            end
            
            if not kaiju.Humanoid then
                table.insert(results, "❌ spawnKaiju: Missing Humanoid")
            else
                if kaiju.Humanoid.Health ~= 500 then
                    table.insert(results, "❌ spawnKaiju: Incorrect health: " .. tostring(kaiju.Humanoid.Health))
                else
                    table.insert(results, "✅ spawnKaiju: Correct health set")
                end
            end
        end
    end
    
    -- Test setupAbilities
    do
        local kaiju = {}
        KaijuSystem:setupAbilities(kaiju)
        
        if not kaiju.energyBeam then
            table.insert(results, "❌ setupAbilities: Missing energyBeam ability")
        else
            table.insert(results, "✅ setupAbilities: energyBeam ability added")
        end
        
        if not kaiju.roar then
            table.insert(results, "❌ setupAbilities: Missing roar ability")
        else
            table.insert(results, "✅ setupAbilities: roar ability added")
        end
    end
    
    return results
end

return runTests
]]></ProtectedString>
