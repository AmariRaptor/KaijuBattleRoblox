									<string name="ScriptGuid">{BA282FD2-FC7A-4616-8789-49E0BD936233}</string>
									<ProtectedString name="Source"><![CDATA[local api = script.Parent.Parent.Parent.Parent.Parent.Parent.API.Assistant
local active = script.Parent.Parent.Parent.Parent.Parent.Parent.API.Assistant.AssistantActivated
local input = script.Parent.Parent.Parent.Parent.Parent.Parent.API.Assistant.InputText
local moving = false

local start = function()
	active.Value = 3
	script.Parent.Parent.Icon:TweenPosition(UDim2.new(0.425,0,0.725,0), "Out", "Quint", 0.5, true)
	game:GetService("TweenService"):Create(script.Parent.Parent.Assistant,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 1}):Play()
	wait (0.25)
	game:GetService("TweenService"):Create(script.Parent.Parent.Assistant,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 0}):Play()
	script.Parent.Parent.Assistant.Text = input.Value --input text
	wait (1.25)
	script.Parent.Parent.Icon:TweenPosition(UDim2.new(0.425,0,0.8,0), "Out", "Quint", 0.5, true)
	game:GetService("TweenService"):Create(script.Parent.Parent.Assistant,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 1}):Play()
	wait (0.5)
	script.Parent.Parent.Icon:TweenPosition(UDim2.new(0.425,0,0.725,0), "Out", "Quint", 0.5, true)
	wait (0.25)
	game:GetService("TweenService"):Create(script.Parent.Parent.Assistant,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency = 0}):Play()
end

local stop = function()
	wait (2.5)
	game:GetService("TweenService"):Create(script.Parent.Parent.Fading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 1}):Play()
	script.Parent.Parent.Icon:TweenPosition(UDim2.new(0.425,0,1,0), "Out", "Quint", 0.5, true)
	script.Parent.Parent.Assistant:TweenPosition(UDim2.new(0.35,0,1,0), "Out", "Quint", 0.5, true)
	wait (0.5)
	script.Parent.Parent.Assistant.Text = ""
	script.Parent.Parent.Visible = false
	wait (1)
	moving = false
	active.Value = 0
end

api.AssistantActivated:GetPropertyChangedSignal("Value"):Connect(function()
	if moving == false then
		if active.Value == 1 then
			if input.Value == "Hey Juniper." then
				moving = true
				active.Value = 1.5
				script.Parent.Parent.Visible = true
				game:GetService("TweenService"):Create(script.Parent.Parent.Fading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 0.5}):Play()
				script.Parent.Parent.Icon:TweenPosition(UDim2.new(0.425,0,0.8,0), "Out", "Quint", 0.5, true)
				wait (0.15)
				script.Parent.Parent.Assistant:TweenPosition(UDim2.new(0.35,0,0.9,0), "Out", "Quint", 0.5, true)
				active.Value = 1.75
				moving = false
			end
		elseif active.Value == 2 then
			moving = true
			if input.Value == "Hi." then
				start()
				script.Parent.Parent.Assistant.Text = "Hi!" --output text
				stop()
			elseif input.Value == "Thank you." then
				start()
				script.Parent.Parent.Assistant.Text = "No problem!" --output text
				stop()
			elseif input.Value == "What's my network status?" then
				start()
				if script.Parent.Parent.Parent.Parent.Parent.Parent.VanillaLinkServices.VanillaConnexa.Connected.Value == true then
					script.Parent.Parent.Assistant.Text = "You're currently connected to " .. script.Parent.Parent.Parent.Parent.Parent.Parent.VanillaLinkServices.VanillaConnexa.Connected.ConnexaName.Value .. "."--output text
				else	
					script.Parent.Parent.Assistant.Text = "You're not currently connected to anything." --output text
				end
				stop()	
			else
				start()
				script.Parent.Parent.Assistant.Text = "I'm sorry I don't understand." --output text
				stop()
			end
		elseif active.Value == 5 then
			active.Value = 3
			start()
			script.Parent.Parent.Assistant.Text = "Letting " .. api.InputName.Value .. " know."
			api.OutputResult.Value = input.Value
			stop()	
		end			
	end
end)

api.Activated:GetPropertyChangedSignal("Value"):Connect(function()
	if api.Activated.Value == true then
		if script.Parent.Parent.Parent.Parent.Enabled == true then
			moving = true
			script.Parent.Parent.Visible = true
			game:GetService("TweenService"):Create(script.Parent.Parent.Fading,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 0.5}):Play()
			script.Parent.Parent.Icon:TweenPosition(UDim2.new(0.425,0,0.8,0), "Out", "Quint", 0.5, true)
			wait (0.15)
			script.Parent.Parent.Assistant:TweenPosition(UDim2.new(0.35,0,0.9,0), "Out", "Quint", 0.5, true)
			active.Value = 4
			moving = false
		end
	end
end)]]></ProtectedString>
