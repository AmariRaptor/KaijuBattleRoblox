        <Properties>
          <string name="Name">BuildingSystem</string>
          <string name="Source"><![CDATA[--!strict
-- BuildingSystem.server.luau
-- Handles all building-related functionality in the game

local BuildingSystem = {}
BuildingSystem.__index = BuildingSystem

-- Services (commented out until needed)
-- local _ReplicatedStorage = game:GetService("ReplicatedStorage")
-- local _ServerStorage = game:GetService("ServerStorage")
-- local _Players = game:GetService("Players")

-- Services (commented out until needed)
-- local _ReplicatedStorage = game:GetService("ReplicatedStorage")
-- local _ServerStorage = game:GetService("ServerStorage")
-- local _Players = game:GetService("Players")

-- Types
type ModelWithPrimaryPart = Model & {
    PrimaryPart: BasePart,
    Destroying: RBXScriptSignal<() -> ()>
}

type BuildingType = {
    HEALTH: number,
    SIZE: Vector3,
    DAMAGE: number,
    COST: number,
    COOLDOWN: number,
    RANGE: number,
    EFFECTS: {[string]: boolean},
    init: (() -> ())?,
    onBuilt: ((self: BuildingType, model: Model) -> ())?,
    onDestroyed: ((self: BuildingType, model: Model) -> ())?,
    onUpdate: ((self: BuildingType, model: Model, dt: number) -> ())?,
    canBuild: ((self: BuildingType, position: Vector3) -> (boolean, string?))?,
    _applyBuildingEffects: (self: BuildingType, model: Model, effects: {[string]: boolean}) -> ()
}

type Building = {
    id: string,
    model: ModelWithPrimaryPart,
    buildingType: string,
    health: number,
    maxHealth: number,
    owner: Player,
    position: Vector3,
    isDestroyed: boolean,
    lastDamageTime: number,
    lastRepairTime: number,
    effects: {[string]: boolean},
    
    update: (self: Building, deltaTime: number) -> (),
    destroy: (self: Building) -> (),
    repair: (self: Building, amount: number) -> (),
    damage: (self: Building, amount: number) -> (),
    getHealthPercentage: (self: Building) -> number,
    addEffect: (self: Building, effectName: string) -> (),
    removeEffect: (self: Building, effectName: string) -> (),
    hasEffect: (self: Building, effectName: string) -> boolean
}

type BuildingSystem = {
    buildings: {[string]: Building},
    BUILDING_TYPES: {[string]: BuildingType},
    init: (self: BuildingSystem) -> (),
    createBuilding: (self: BuildingSystem, buildingType: string, position: Vector3, owner: Player) -> Building?,
    updateAll: (self: BuildingSystem, deltaTime: number) -> (),
    _createBuildingModel: (self: BuildingSystem, buildingType: string, position: Vector3) -> ModelWithPrimaryPart,
    _applyBuildingEffects: (self: BuildingSystem, model: ModelWithPrimaryPart, effects: {[string]: boolean}) -> ()
}

local BuildingSystemImpl = {}
BuildingSystemImpl.__index = BuildingSystemImpl

local _BUILDING_TYPES = {
    SKYSCRAPER = {
        HEALTH = 200,
        SIZE = Vector3.new(10, 50, 10),
        DAMAGE = 5,
        COST = 100,
        COOLDOWN = 10,
        RANGE = 20,
        EFFECTS = {
            SMOKE = true,
            LIGHTS = true
        },
        _applyBuildingEffects = function(self: BuildingType, model: Model, effects: {[string]: boolean})
            for effectName, enabled in pairs(effects) do
                if not enabled then continue end
                
                if effectName == "SMOKE" then
                    local smoke = Instance.new("Smoke")
                    smoke.Color = Color3.fromRGB(200, 200, 200)
                    smoke.Opacity = 0.5
                    smoke.RiseVelocity = 5
                    smoke.Size = 5
                    smoke.Parent = model.PrimaryPart
                elseif effectName == "LIGHTS" then
                    local light = Instance.new("PointLight")
                    light.Brightness = 1
                    light.Range = 20
                    light.Color = Color3.fromRGB(255, 255, 200)
                    light.Parent = model.PrimaryPart
                end
            end
        end
    },
    
    HOSPITAL = {
        HEALTH = 150,
        SIZE = Vector3.new(20, 15, 20),
        DAMAGE = 0,
        COST = 150,
        COOLDOWN = 15,
        RANGE = 25,
        EFFECTS = {
            LIGHTS = true,
            HEALING_AURA = true
        },
        _applyBuildingEffects = function(self: BuildingType, model: Model, effects: {[string]: boolean})
            for effectName, enabled in pairs(effects) do
                if not enabled then continue end
                
                if effectName == "LIGHTS" then
                    local light = Instance.new("PointLight")
                    light.Brightness = 1
                    light.Range = 20
                    light.Color = Color3.fromRGB(255, 255, 200)
                    light.Parent = model.PrimaryPart
                elseif effectName == "HEALING_AURA" then
                    -- Add healing aura effect
                    local aura = Instance.new("ParticleEmitter")
                    aura.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 255, 200))
                    })
                    aura.LightEmission = 0.8
                    aura.LightInfluence = 0
                    aura.Size = NumberSequence.new(2)
                    aura.Texture = "rbxassetid://296874871"
                    aura.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.5),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    aura.Lifetime = NumberRange.new(1, 2)
                    aura.Rate = 10
                    aura.Speed = NumberRange.new(2)
                    aura.SpreadAngle = Vector2.new(0, 180)
                    aura.Parent = model.PrimaryPart
                end
            end
        end
    }
}

-- Constructor (kept for backward compatibility)
function BuildingSystem.new()
    local self = setmetatable({
        buildings = {},
        BUILDING_TYPES = _BUILDING_TYPES
    }, BuildingSystem)
    
    -- Initialize the system
    self:init()
    
    return self
end

-- Standardized init method
function BuildingSystem:init()
    print("🔄 Initializing BuildingSystem...")
    
    -- Set up buildings folder
    if not workspace:FindFirstChild("Buildings") then
        local buildingsFolder = Instance.new("Folder")
        buildingsFolder.Name = "Buildings"
        buildingsFolder.Parent = workspace
    end
    
    -- Initialize building types
    for _, buildingType in pairs(self.BUILDING_TYPES) do
        if type(buildingType) == "table" and buildingType.init then
            buildingType:init()
        end
    end
    
    print("✅ BuildingSystem initialized successfully")
    return true
end

-- Create a new building
function BuildingSystemImpl:createBuilding(buildingType: string, position: Vector3, owner: Player): Building?
    local buildingTypeConfig = self.BUILDING_TYPES[buildingType]
    if not buildingTypeConfig then
        warn("Invalid building type:", buildingType)
        return nil
    end
    
    -- Create the building model
    local buildingModel = self:_createBuildingModel(buildingType, position)
    
    -- Create the building object
    local building = buildingTypeConfig.create(buildingTypeConfig, buildingModel)
    
    -- Apply building effects
    self:_applyBuildingEffects(buildingModel, buildingTypeConfig.EFFECTS)
    
    -- Store the building
    self.buildings[building.id] = building
    
    -- Set up destruction handler
    buildingModel.Destroying:Connect(function()
        self.buildings[building.id] = nil
    end)
    
    return building
end

-- Internal: Create a building model
function BuildingSystem:_createBuildingModel(buildingType: string, position: Vector3): ModelWithPrimaryPart
    local buildingConfig = self.BUILDING_TYPES[buildingType]
    if not buildingConfig then
        error("Invalid building type: " .. tostring(buildingType))
    end
    
    local model = Instance.new("Model")
    local primaryPart = Instance.new("Part")
    
    -- Configure the primary part
    primaryPart.Name = "PrimaryPart"
    primaryPart.Size = buildingConfig.SIZE
    primaryPart.Position = position
    primaryPart.Anchored = true
    primaryPart.CanCollide = true
    primaryPart.Parent = model
    
    -- Set the primary part
    model.PrimaryPart = primaryPart
    
    -- Add to workspace
    local buildingsFolder = workspace:FindFirstChild("Buildings") or Instance.new("Folder")
    buildingsFolder.Name = "Buildings"
    buildingsFolder.Parent = workspace
    model.Parent = buildingsFolder
    
    -- Set model name
    model.Name = buildingType .. "_" .. tostring(os.time())
    
    return model :: ModelWithPrimaryPart
end

-- Internal: Apply visual effects to a building
function BuildingSystem:_applyBuildingEffects(building: ModelWithPrimaryPart, effects: {[string]: boolean})
    for effectName, enabled in pairs(effects) do
        if not enabled then continue end
        
        if effectName == "SMOKE" then
            local smoke = Instance.new("Smoke")
            smoke.Color = Color3.fromRGB(200, 200, 200)
            smoke.Opacity = 0.5
            smoke.RiseVelocity = 5
            smoke.Size = 5
            smoke.Parent = building.PrimaryPart
        elseif effectName == "LIGHTS" then
            local light = Instance.new("PointLight")
            light.Brightness = 1
            light.Range = 20
            light.Color = Color3.fromRGB(255, 255, 200)
            light.Parent = building.PrimaryPart
        elseif effectName == "HEALING_AURA" then
            -- Add healing aura effect
            local aura = Instance.new("ParticleEmitter")
            aura.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 255, 200))
            })
            aura.LightEmission = 0.8
            aura.LightInfluence = 0
            aura.Size = NumberSequence.new(2)
            aura.Texture = "rbxassetid://296874871"
            aura.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.5),
                NumberSequenceKeypoint.new(1, 1)
            })
            aura.Lifetime = NumberRange.new(1, 2)
            aura.Rate = 10
            aura.Speed = NumberRange.new(2)
            aura.SpreadAngle = Vector2.new(0, 180)
            aura.Parent = building.PrimaryPart
        end
    end
end

-- Constructor (kept for backward compatibility)
function BuildingSystem.new()
    local self = setmetatable({}, BuildingSystem)
    
    -- Initialize properties
    self.buildings = {}
    self.BUILDING_TYPES = _BUILDING_TYPES
    
    -- Set up any necessary connections or initialization here
    
    return self
end

-- Standardized init method
function BuildingSystem:init()
    print("🔄 Initializing BuildingSystem...")
    
    -- Create buildings folder if it doesn't exist
    if not workspace:FindFirstChild("Buildings") then
        local buildingsFolder = Instance.new("Folder")
        buildingsFolder.Name = "Buildings"
        buildingsFolder.Parent = workspace
    end
    
    -- Any additional initialization logic here
    
    print("✅ BuildingSystem initialized successfully")
    return true
end

-- Module exports
return BuildingSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">CharacterSystem</string>
          <string name="Source"><![CDATA[--!strict
-- CharacterSystem.server.luau
-- Handles character initialization and class-based attributes for players

-- Services
local Players = game:GetService("Players")

-- Types
type CharacterAttributes = {
    MaxHealth: number,
    WalkSpeed: number,
    JumpPower: number,
    Abilities: {string}?
}

type CharacterSystem = {
    init: () -> (),
    onPlayerAdded: (player: Player) -> (),
    onCharacterAdded: (character: Model) -> (),
    getClassAttributes: (className: string) -> CharacterAttributes?
}

-- Default configuration (will be overridden by GameConfig if available)
local Config = {
    Classes = {
        Kaiju = {
            MaxHealth = 500,
            WalkSpeed = 24,
            JumpPower = 50,
            Abilities = {"Smash", "Charge", "Roar"}
        },
        Guardian = {
            MaxHealth = 200,
            WalkSpeed = 16,
            JumpPower = 50,
            Abilities = {"ShieldBash", "Taunt", "Rally"}
        },
        Engineer = {
            MaxHealth = 150,
            WalkSpeed = 18,
            JumpPower = 50,
            Abilities = {"Repair", "Turret", "SpeedBoost"}
        }
    }
}

-- Try to load GameConfig, but don't fail if it doesn't exist
local success, gameConfig = pcall(function()
    return require(script.Parent.Parent.Parent.shared.config.GameConfig)
end)

if success and gameConfig then
    Config = gameConfig
end

local CharacterSystem: CharacterSystem = {}
CharacterSystem.__index = CharacterSystem

--[[
    Gets the attributes for a specific class.
    @param className string The name of the class to get attributes for.
    @return CharacterAttributes? The attributes for the class, or nil if not found.
]]
function CharacterSystem.getClassAttributes(className: string): CharacterAttributes?
    return Config.Classes[className]
end

--[[
    Sets up a character when it is added to the game.
    @param character Model The character model that was added.
]]
function CharacterSystem.onCharacterAdded(character: Model)
    local player = Players:GetPlayerFromCharacter(character)
    if not player then
        warn("Character added without a valid player")
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        warn("Character has no Humanoid")
        return
    end

    local playerClassValue = player:FindFirstChild("PlayerClass")
    if not playerClassValue or not playerClassValue:IsA("StringValue") then
        warn("Player has no valid PlayerClass")
        return
    end

    local className = playerClassValue.Value
    local attributes = CharacterSystem.getClassAttributes(className)
    
    if not attributes then
        warn(string.format("No attributes found for class: %s", className))
        return
    end

    -- Apply class attributes
    humanoid.MaxHealth = attributes.MaxHealth
    humanoid.Health = attributes.MaxHealth
    humanoid.WalkSpeed = attributes.WalkSpeed
    humanoid.JumpPower = attributes.JumpPower

    -- Add class tag for identification
    local classTag = character:FindFirstChild("ClassTag") or Instance.new("StringValue")
    classTag.Name = "ClassTag"
    classTag.Value = className
    classTag.Parent = character

    print(string.format(
        "%s's character created. Class: %s, MaxHealth: %d, WalkSpeed: %d, JumpPower: %d",
        player.Name,
        className,
        humanoid.MaxHealth,
        humanoid.WalkSpeed,
        humanoid.JumpPower
    ))
end

--[[
    Connects the CharacterAdded event for a given player.
    @param player Player The player to connect the event for.
]]
function CharacterSystem.onPlayerAdded(player: Player)
    if not player or not player:IsA("Player") then
        warn("Invalid player provided to onPlayerAdded")
        return
    end

    -- Set up PlayerClass if it doesn't exist
    if not player:FindFirstChild("PlayerClass") then
        local playerClass = Instance.new("StringValue")
        playerClass.Name = "PlayerClass"
        playerClass.Value = "Guardian" -- Default class
        playerClass.Parent = player
    end

    -- Connect character added event
    player.CharacterAdded:Connect(function(character)
        task.wait() -- Wait for character to fully load
        CharacterSystem.onCharacterAdded(character)
    end)

    -- Set up existing character if it exists
    if player.Character then
        task.defer(function()
            CharacterSystem.onCharacterAdded(player.Character)
        end)
    end
end

--[[
    Initializes the CharacterSystem.
]]
--[[
    Initializes the CharacterSystem.
    @return boolean True if initialization was successful
]]
function CharacterSystem.init()
    -- Connect to all current and future players
    Players.PlayerAdded:Connect(CharacterSystem.onPlayerAdded)
    
    -- Set up existing players
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(CharacterSystem.onPlayerAdded, player)
    end
    
    print("CharacterSystem initialized")
    return true -- Indicate successful initialization
end

return CharacterSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">ClassSystem</string>
          <string name="Source"><![CDATA[--!strict

--[[
    @class ClassSystem
    @server

    Handles assigning classes (Kaiju, Guardian, Engineer) to players
    and managing class-specific abilities and attributes.
]]
local ClassSystem = {}

local Players = game:GetService("Players")

-- For now, we'll define the classes in a simple table.
-- This could be expanded into separate modules later.
local CLASSES = {
    "Kaiju",
    "Guardian",
    "Engineer"
} :: {string}

--[[
    Assigns a random class to a player.
    @param player The player to assign a class to.
    @return string The class that was assigned.
]]
function ClassSystem.assignRandomClass(player: Player): string
    -- Remove existing class if it exists
    local existingClass = player:FindFirstChild("PlayerClass")
    if existingClass and existingClass:IsA("StringValue") then
        existingClass:Destroy()
    end
    
    -- Create a value to store the player's class
    local playerClass = Instance.new("StringValue")
    playerClass.Name = "PlayerClass"
    
    -- Assign a random class
    local randomIndex = math.random(1, #CLASSES)
    local className = CLASSES[randomIndex] :: string
    playerClass.Value = className
    playerClass.Parent = player

    print(string.format("%s has been assigned the class: %s", player.Name, className))
    return className
end

--[[
    Called when a player is added to the game.
    @param player The player who joined.
]]
local function onPlayerAdded(player: Player)
    -- Assign a random class to the player
    ClassSystem.assignRandomClass(player)
    
    -- TODO: Connect to character added to give tools/abilities
end

--[[
    Initializes the ClassSystem.
    @return boolean True if initialization was successful
]]
function ClassSystem.init()
    -- Connect to player joining event
    Players.PlayerAdded:Connect(onPlayerAdded)
    
    -- Initialize existing players
    for _, player in ipairs(Players:GetPlayers() :: {Player}) do
        task.spawn(onPlayerAdded, player)
    end
    
    return true -- Indicate successful initialization
end

return ClassSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">KaijuSystem</string>
          <string name="Source"><![CDATA[--!strict
-- KaijuSystem.server.luau
-- Handles Kaiju-specific functionality and abilities

-- Services
local _ReplicatedStorage = game:GetService("ReplicatedStorage")
local _Players = game:GetService("Players")

-- Types
type KaijuAbilities = {
    energyBeam: RemoteEvent,
    roar: Sound,
    roarEvent: RemoteEvent
}

local KaijuSystem = {}
KaijuSystem.__index = KaijuSystem

-- Default configuration (will be overridden by GameConfig if available)
local Config = {
    Kaiju = {
        Size = Vector3.new(10, 5, 10),
        BaseHealth = 500,
        Abilities = {
            Roar = {
                SoundId = "123456789"
            }
        }
    },
    Classes = {
        Kaiju = {
            WalkSpeed = 24,
            JumpPower = 50
        }
    }
}

-- Try to load GameConfig, but don't fail if it doesn't exist
local success, gameConfig = pcall(function()
    return require(script.Parent.Parent.Parent.shared.config.GameConfig)
end)

if success and gameConfig then
    Config = gameConfig
end

-- Private functions
local function validatePlayer(player: Player): (boolean, string?)
    if not player or not player:IsA("Player") then
        return false, "Invalid player"
    end
    return true
end

local function createKaijuModel(): Model
    local kaiju = Instance.new("Model")
    kaiju.Name = "Kaiju"
    
    -- Add hitbox (torso)
    local hitbox = Instance.new("Part")
    hitbox.Name = "HumanoidRootPart"
    hitbox.Size = Config.Kaiju.Size
    hitbox.Position = Vector3.new(0, Config.Kaiju.Size.Y / 2 + 5, 0)
    hitbox.Anchored = false
    hitbox.CanCollide = true
    hitbox.Massless = false
    hitbox.Parent = kaiju
    
    -- Add humanoid with configurable stats
    local humanoid = Instance.new("Humanoid")
    humanoid.MaxHealth = Config.Kaiju.BaseHealth
    humanoid.Health = humanoid.MaxHealth
    humanoid.WalkSpeed = Config.Classes.Kaiju.WalkSpeed
    humanoid.JumpPower = Config.Classes.Kaiju.JumpPower
    humanoid.Parent = kaiju
    
    -- Add tag for identification
    local tag = Instance.new("StringValue")
    tag.Name = "KaijuTag"
    tag.Value = "true"
    tag.Parent = kaiju
    
    return kaiju
end

-- Constructor (kept for backward compatibility)
function KaijuSystem.new()
    local self = setmetatable({}, KaijuSystem)
    
    -- Initialize the system
    self:init()
    
    return self
end

-- Standardized init method
function KaijuSystem:init()
    print("🔄 Initializing KaijuSystem...")
    
    -- Initialize any necessary properties
    self.players = {}
    
    -- Set up any event connections here
    
    print("✅ KaijuSystem initialized successfully")
    return true
end

function KaijuSystem:spawnKaiju(player: Player): Model
    local success, errorMsg = validatePlayer(player)
    if not success then
        error(errorMsg or "Failed to spawn Kaiju")
    end
    
    local character = player.Character or player.CharacterAdded:Wait()
    
    -- Clean up existing Kaiju if it exists
    local existingKaiju = character:FindFirstChild("Kaiju")
    if existingKaiju then
        existingKaiju:Destroy()
    end
    
    -- Create and set up new Kaiju
    local kaiju = createKaijuModel()
    kaiju.Parent = character
    
    -- Set up abilities
    self:setupAbilities(kaiju)
    
    return kaiju
end

function KaijuSystem:setupAbilities(kaiju: Model): KaijuAbilities
    if not kaiju or not kaiju:IsA("Model") then
        error("Invalid Kaiju model provided")
    end
    
    -- Energy beam ability
    local energyBeam = Instance.new("RemoteEvent")
    energyBeam.Name = "EnergyBeam"
    energyBeam.Parent = kaiju
    
    -- Set up energy beam handler
    energyBeam.OnServerEvent:Connect(function(player: Player, targetPosition: Vector3)
        self:onAbilityUsed(player, "EnergyBeam", {target = targetPosition})
    end)
    
    -- Roar ability
    local roar = Instance.new("Sound")
    roar.Name = "Roar"
    roar.SoundId = "rbxassetid://" .. Config.Kaiju.Abilities.Roar.SoundId or ""
    roar.Volume = 1
    roar.Parent = kaiju
    
    -- Set up roar handler
    local roarEvent = Instance.new("RemoteEvent")
    roarEvent.Name = "RoarEvent"
    roarEvent.Parent = kaiju
    
    roarEvent.OnServerEvent:Connect(function(player: Player, ...: any)
        self:onAbilityUsed(player, "Roar", ...)
    end)
    
    return {
        energyBeam = energyBeam,
        roar = roar,
        roarEvent = roarEvent
    }
end

function KaijuSystem:onAbilityUsed(player: Player, abilityName: string, abilityData: {[string]: any}?)
    if not player or not player.Character then 
        warn("Invalid player or character for ability use:", player, abilityName)
        return 
    end
    
    local kaiju = player.Character:FindFirstChild("Kaiju")
    if not kaiju then 
        warn("No Kaiju model found for player:", player.Name)
        return 
    end
    
    -- Handle different abilities
    if abilityName == "EnergyBeam" then
        self:handleEnergyBeam(player, kaiju, abilityData or {})
    elseif abilityName == "Roar" then
        self:handleRoar(player, kaiju, abilityData or {})
    else
        warn("Unknown ability:", abilityName)
    end
end

function KaijuSystem:handleEnergyBeam(player: Player, kaiju: Model, data: {target: Vector3})
    -- Implement energy beam logic
    print(string.format("%s used EnergyBeam at position: %s", player.Name, tostring(data.target)))
    -- TODO: Add cooldown, damage calculation, and visual effects
end

function KaijuSystem:handleRoar(player: Player, kaiju: Model, data: {})
    -- Implement roar logic
    print(string.format("%s used Roar", player.Name))
    
    -- Play roar sound if it exists
    local roarSound = kaiju:FindFirstChild("Roar")
    if roarSound and roarSound:IsA("Sound") then
        roarSound:Play()
    end
    
    -- TODO: Add cooldown and area effect logic
end

return KaijuSystem
]]></string>
