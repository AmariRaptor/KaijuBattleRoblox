    </Properties>
    <Item class="Script" referent="33">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- This script is the main entry point for the server.
-- It requires and initializes the main game module.

local ServerScriptService = game:GetService("ServerScriptService")

-- Wait for the MainModule to exist to avoid race conditions
local _mainModule = ServerScriptService:WaitForChild("MainModule")

-- Once we know it exists, require it directly using its full path.
-- This is standard practice and helps static analysis tools understand the code.
local main = require(game.ServerScriptService.MainModule)

if main and type(main.init) == "function" then
    main:init()
else
    warn("MainModule did not return a valid module or was missing an init function.")
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="34">
      <Properties>
        <string name="Name">MainModule</string>
        <string name="Source">--!strict

print("Server initialization started.")

-- Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- Module interface
local MainModule = {}
MainModule.__index = MainModule

-- State
local initialized = false
local initializedSystems = {}

-- List of systems to load
local systemsToLoad = {
    "ClassSystem",
    "CharacterSystem",
    "BuildingSystem",
    "KaijuSystem",
    "ScoringSystem"
}

-- Initialize a single system
local function initializeSystem(name: string): any
    print(`\n🔍 [${os.clock()}] Initializing system: {name}`)
    
    -- Look for systems folder in ServerScriptService
    print("🔍 [1/7] Looking for 'systems' folder in ServerScriptService...")
    local systemsFolder = ServerScriptService:FindFirstChild("systems")
    
    if not systemsFolder then
        print("ℹ️ 'systems' folder not found in ServerScriptService, checking parent directory...")
        systemsFolder = script.Parent and script.Parent:FindFirstChild("systems")
        if not systemsFolder then
            warn("❌ ERROR: 'systems' folder not found in ServerScriptService or script parent")
            return nil
        end
    end
    
    print(`✅ Found systems folder at: {systemsFolder:GetFullName()}`)
    
    -- List all modules in the systems folder for debugging
    print("📋 [2/7] Modules in systems folder:")
    local foundModule = false
    for _, child in ipairs(systemsFolder:GetChildren()) do
        print(`- {child.Name} (Type: {child.ClassName})`)
        if child.Name == name and child:IsA("ModuleScript") then
            foundModule = true
            print(`  ✅ Found matching ModuleScript for {name}`)
        end
    end
    if not foundModule then
        print(`❌ [2/7] No ModuleScript found with name: {name}`)
    end
    
    print(`\n🔍 [3/7] Looking for module: {name}`)
    local modulePath = systemsFolder:FindFirstChild(name, true) -- Recursive search
    
    if not modulePath then
        warn(`❌ ERROR: System module not found: {name}`)
        local availableModules = {}
        for _, child in ipairs(systemsFolder:GetChildren()) do
            table.insert(availableModules, child.Name)
        end
        warn(`   Available modules: {table.concat(availableModules, ", ")}`)
        return nil
    end
    
    print(`✅ Found module: {modulePath:GetFullName()}`)
    
    -- Check if it's a ModuleScript
    print(`🔍 [4/7] Verifying module type...`)
    if not modulePath:IsA("ModuleScript") then
        warn(`❌ ERROR: {name} is not a ModuleScript (found: {modulePath.ClassName})`)
        return nil
    end
    
    -- Require the module
    print(`📦 [5/7] Requiring module: {name}...`)
    print(`    Path: {modulePath:GetFullName()}`)
    local success, result = pcall(require, modulePath)
    
    if not success then
        warn(`❌ ERROR: Failed to require system {name}:`)
        warn(result)
        return nil
    end
    
    print(`✅ Successfully required module: {name}`)
    print(`📝 Module type: {type(result)}`)
    
    -- Check the result type
    print(`🔍 [6/7] Verifying module result type...`)
    if type(result) ~= "table" then
        warn(`❌ ERROR: {name} did not return a table (got: {type(result)})`)
        return nil
    end
    
    -- Check for required methods
    print("🔍 Checking for required methods...")
    if type(result.init) ~= "function" then
        warn(`⚠️ WARNING: {name} is missing init() method - adding default implementation`)
        result.init = function()
            print(`✅ {name} initialized (default implementation)`)
            return true
        end
    end
    
    -- Initialize the system
    print(`🔄 [7/7] Calling {name}:init()...`)
    print(`    Init function type: {type(result.init)}`)
    local initSuccess, initResult = pcall(function()
        return result.init(result)
    end)
    
    if not initSuccess then
        warn(`❌ ERROR: {name}:init() failed with error:`)
        warn(initResult)
        return nil
    end
    
    -- Verify initialization result
    if initResult == false then
        warn(`⚠️ WARNING: {name}:init() returned false, indicating initialization failure`)
        return nil
    end
    
    print(`✅ {name} initialized successfully`)
    return result
end

-- Check if MainModule is initialized
function MainModule:isInitialized()
    return initialized
end

-- Get a system by name
function MainModule:getSystem(systemName: string)
    return initializedSystems[systemName]
end

-- Get all initialized systems
function MainModule:getInitializedSystems()
    local result = {}
    for name, system in pairs(initializedSystems) do
        result[name] = system
    end
    return result
end

-- Initialize the MainModule
function MainModule:init()
    print("\n=== MainModule:init() started ===")
    print("Current environment:", game:GetFullName())
    print("Systems to load count:", #systemsToLoad)
    for i, sys in ipairs(systemsToLoad) do
        print(string.format("  [%d] %s", i, tostring(sys)))
    end
    
    if self:isInitialized() then
        warn("MainModule already initialized")
        return true
    end
    
    print("🚀 Initializing MainModule...")
    print("\n🔧 Starting system initialization...")
    
    -- Debug: Print systemsToLoad table
    print("📋 Systems to load (count: " .. #systemsToLoad .. "):")
    for i, name in ipairs(systemsToLoad) do
        print(string.format("  [%d] %s (type: %s)", i, tostring(name), type(name)))
    end
    
    -- Set up shared folders
    print("\n🛠️ Setting up shared folders...")
    local shared = Instance.new("Folder")
    shared.Name = "Shared"
    shared.Parent = ReplicatedStorage
    
    -- Use existing systems folder or create it if it doesn't exist
    print("\n📂 Locating systems folder...")
    local systemsFolder = ServerScriptService:FindFirstChild("systems")
    if not systemsFolder then
        print("ℹ️ 'systems' folder not found in ServerScriptService, creating...")
        systemsFolder = Instance.new("Folder")
        systemsFolder.Name = "systems"
        systemsFolder.Parent = ServerScriptService
    else
        print("✅ Found existing 'systems' folder")
    end
    
    -- List all modules in systems folder for debugging
    print("\n📦 Modules in systems folder:")
    local moduleCount = 0
    for _, child in ipairs(systemsFolder:GetChildren()) do
        print(string.format("  - %s (%s)", child.Name, child.ClassName))
        moduleCount += 1
    end
    print("  Total modules found:", moduleCount)
    
    -- Initialize all systems
    print("\n🔧 Initializing systems...")
    local successCount = 0
    local failCount = 0
    
    -- Debug: Print ServerScriptService contents
    print("\n📂 ServerScriptService contents:")
    for _, child in ipairs(ServerScriptService:GetChildren()) do
        print(string.format("  - %s (%s)", child.Name, child.ClassName))
    end
    
    -- Debug: Check systems folder
    local systemsFolder = ServerScriptService:FindFirstChild("systems")
    print("\n🔍 Systems folder exists:", systemsFolder ~= nil)
    if systemsFolder then
        print("📂 Systems folder contents:")
        for _, child in ipairs(systemsFolder:GetChildren()) do
            print(string.format("  - %s (%s)", child.Name, child.ClassName))
        end
    end
    
    for i, systemName in ipairs(systemsToLoad) do
        print("\n" .. string.rep("=", 50))
        print(string.format("🔄 [%d/%d] Initializing system: %s", i, #systemsToLoad, systemName))
        
        -- Try to initialize the system
        local system = initializeSystem(systemName)
        
        if system then
            print(string.format("✅ Successfully initialized %s", systemName))
            initializedSystems[systemName] = system
            successCount += 1
            
            -- Verify the system was added to initializedSystems
            if initializedSystems[systemName] == system then
                print("  ✓ System reference stored in initializedSystems")
            else
                warn("  ❌ System reference NOT stored in initializedSystems!")
            end
        else
            print(string.format("❌ Failed to initialize %s", systemName))
            failCount += 1
            
            -- Try to find the module directly for more detailed error
            local moduleScript = systemsFolder:FindFirstChild(systemName)
            if moduleScript and moduleScript:IsA("ModuleScript") then
                print("🔍 Attempting direct require...")
                local success, result = pcall(require, moduleScript)
                if success then
                    print("✅ Direct require succeeded!")
                    print("   Module type:", type(result))
                    if type(result) == "table" then
                        print("   Has init function:", type(result.init) == "function")
                    end
                else
                    print(`❌ Direct require of {systemName} failed: {tostring(result)}`)
                end
            end
        end
    end
    
    -- Mark as initialized
    initialized = true
    print("\n✅ MainModule initialization complete")
    
    -- Connect player events
    game.Players.PlayerAdded:Connect(function(player)
        print(`Player {player.Name} joined the game`)
        
        -- Assign initial class
                local classSystem = self:getSystem("ClassSystem" :: any)
        if classSystem and type(classSystem.assignRandomClass) == "function" then
            classSystem.assignRandomClass(player)
        end
        
        -- Set up character
                local characterSystem = self:getSystem("CharacterSystem" :: any)
        if characterSystem and type(characterSystem.setupCharacter) == "function" then
            player.CharacterAdded:Connect(function(character)
                local class = player:FindFirstChild("PlayerClass")
                if class then
                    characterSystem.setupCharacter(player, class.Value)
                end
            end)
        end
    end)
    
    return true
end

-- Return the MainModule
return MainModule</string>
      </Properties>
    </Item>
    <Item class="Script" referent="35">
      <Properties>
        <string name="Name">PowerController</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- PowerController.server.luau
-- Handles power activation and cooldowns on the server

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Import the PowerSystem
local PowerSystem = require(ReplicatedStorage:WaitForChild("PowerSystem"))

-- Remote events for client-server communication
local PowerEvents = Instance.new("Folder")
PowerEvents.Name = "PowerEvents"

local PowerActivated = Instance.new("RemoteEvent")
PowerActivated.Name = "PowerActivated"
PowerActivated.Parent = PowerEvents

local PowerCooldown = Instance.new("RemoteEvent")
PowerCooldown.Name = "PowerCooldown"
PowerCooldown.Parent = PowerEvents

PowerEvents.Parent = ReplicatedStorage

-- Class to power mappings
local CLASS_POWERS = {
    Kaiju = {
        "Roar",
        "Stomp",
        "TailWhip"
    },
    Guardian = {
        "ShieldBash",
        "ProtectiveAura",
        "HealingWave"
    },
    Engineer = {
        "TurretDeploy",
        "Barrier",
        "EMP"
    }
}

-- Handle power activation requests from clients
PowerActivated.OnServerEvent:Connect(function(player: Player, powerName: string)
    -- Check if the player's class has access to this power
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local playerClass = player:FindFirstChild("PlayerClass")
    if not playerClass or not playerClass:IsA("StringValue") then return end
    
    local classPowers = CLASS_POWERS[playerClass.Value]
    if not classPowers or not table.find(classPowers, powerName) then
        -- Player doesn't have access to this power
        return
    end
    
    -- Try to use the power
    local success, message = PowerSystem:usePower(player, powerName)
    
    if success then
        -- Notify all clients that the power was activated
        PowerActivated:FireAllClients(player, powerName)
        
        -- Notify the player of cooldown
        local power = PowerSystem:getPower(powerName)
        if power then
            PowerCooldown:FireClient(player, powerName, power.cooldown)
        end
    elseif message then
        -- Notify the player of the error
        warn(string.format("Power activation failed for %s: %s", player.Name, message))
    end
end)

-- Clean up when players leave
Players.PlayerRemoving:Connect(function(player)
    -- Clean up any power-related data for this player
    for _, power in pairs(PowerSystem) do
        if type(power) == "table" and power.lastUsed then
            power.lastUsed[player.UserId] = nil
        end
    end
end)

print("PowerController initialized")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="36">
      <Properties>
        <string name="Name">RunCoverageDemo</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- RunCoverageDemo.server.luau
-- Script to run the coverage demo test in Roblox Studio using TestEZ

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local _ServerStorage = game:GetService("ServerStorage")
local _TestService = game:GetService("TestService") -- Used for future test execution

print("🔍 Starting Coverage Demo Test...")

-- Load TestEZ modules from ReplicatedStorage with timeouts
local function safeWaitForChild(parent: Instance, name: string, timeout: number?): Instance?
    local child = parent:FindFirstChild(name)
    if child then return child end
    
    if timeout then
        return parent:WaitForChild(name, timeout)
    end
    return parent:WaitForChild(name)
end

-- Load TestEZ with error handling
local function safeRequire(module: Instance): any?
    local success, result = pcall(require, module)
    if not success then
        warn(`❌ Failed to load {module:GetFullName()}: {result}`)
        return nil
    end
    return result
end

-- Get TestEZ folder with timeout
local TestEZ = safeWaitForChild(ReplicatedStorage, "TestEZ", 5)
if not TestEZ then
    error("❌ TestEZ not found in ReplicatedStorage. Please ensure it's properly mapped in Rojo.")
end

-- Load TestEZ components
local testBootstrapModule = safeWaitForChild(TestEZ, "TestBootstrap", 5)
local _TestBootstrap = testBootstrapModule and safeRequire(testBootstrapModule)

local reportersFolder = safeWaitForChild(TestEZ, "Reporters", 5)
local textReporterModule = reportersFolder and safeWaitForChild(reportersFolder, "TextReporter", 5)
local _TextReporter = textReporterModule and safeRequire(textReporterModule)

-- Debugging the reporter
print("--- DEBUGGING ---")
print("TextReporter type: ", type(_TextReporter))
if type(_TextReporter) == "table" then
	print("TextReporter.report type: ", type(_TextReporter.report))
end
print("--- END DEBUGGING ---")

-- Verify TestEZ is loaded
if not (_TestBootstrap and _TextReporter) then
    error("❌ Failed to load required TestEZ modules. Please check the TestEZ installation.")
end

-- Find all test files
local function findTestFiles()
    local testFiles = {}
    local function scan(folder)
        for _, child in ipairs(folder:GetDescendants()) do
            if child:IsA("ModuleScript") and child.Name:match("%.spec$") then
                table.insert(testFiles, child)
            end
        end
    end
    
    -- Look for test files in ServerStorage/Tests
    local testsFolder = _ServerStorage:FindFirstChild("Tests")
    if testsFolder then
        scan(testsFolder)
    end
    
    -- Also check for our specific coverage demo test
    local coverageDemoTest = _ServerStorage:FindFirstChild("Tests/coverage_demo.spec")
    if coverageDemoTest and coverageDemoTest:IsA("ModuleScript") then
        table.insert(testFiles, coverageDemoTest)
    end
    
    return testFiles
end

-- Run the tests
local function runTests()
    print("\n🔍 Discovering test files...")
    local testFiles = findTestFiles()
    
    if #testFiles == 0 then
        warn("❌ No test files found!")
        return false
    end
    
    print("\n📋 Found " .. #testFiles .. " test files:")
    for _, testFile in ipairs(testFiles) do
        print("   ✓ " .. testFile:GetFullName())
    end
    
    print("\n🚀 Running tests individually...\n")
    
    local allTestsPassed = true

    for _, testFile in ipairs(testFiles) do
        print("--- Running test: " .. testFile:GetFullName() .. " ---")
        local success, results = pcall(function() 
            return _TestBootstrap:run({testFile}, _TextReporter, { showTimingInfo = false })
        end)

        if not success then
            warn("❌ Error running test file: " .. testFile:GetFullName())
            warn(results)
            allTestsPassed = false
        elseif type(results) == "table" and results.failureCount > 0 then
            allTestsPassed = false
            print("--- Test failed: " .. testFile:GetFullName() .. " ---")
        else
            print("--- Test passed: " .. testFile:GetFullName() .. " ---")
        end
    end
    
    return allTestsPassed
end

-- Start the test execution
local testsPassed = runTests()

-- Print final status
print("\n" .. (testsPassed and "✅ All tests completed successfully!" or "❌ Some tests failed!"))
return testsPassed
]]></string>
      </Properties>
