          <string name="Name">BuildingSystemDirectTest</string>
          <string name="Source"><![CDATA[--!strict
-- BuildingSystemDirectTest.luau
-- A direct test for BuildingSystem functionality with strict Luau types

print("=== Starting BuildingSystemDirectTest ===")

-- Types
type BuildingType = {
    HEALTH: number,
    SIZE: Vector3,
    DAMAGE: number,
    REPAIR_RATE: number,
    EFFECTS: {[string]: boolean}
}

type BuildingSystem = {
    BUILDING_TYPES: {
        [string]: BuildingType
    },
    CreateBuilding: (self: BuildingSystem, buildingType: string, position: Vector3) -> Model,
    CalculateDamage: (self: BuildingSystem, building: Model, damage: number) -> boolean,
    RepairBuilding: (self: BuildingSystem, building: Model) -> boolean,
    GetBuildingHealth: (self: BuildingSystem, building: Model) -> number?
}

-- Define the test function
local function testBuildingSystem(): (boolean, string)
    -- Mock the BuildingSystem with proper types
    local BuildingSystem: BuildingSystem = {
        BUILDING_TYPES = {
            SKYSCRAPER = {
                HEALTH = 200,
                SIZE = Vector3.new(10, 50, 10),
                DAMAGE = 5,
                REPAIR_RATE = 2,
                EFFECTS = {SMOKE = true, LIGHTS = true}
            },
            FACTORY = {
                HEALTH = 150,
                SIZE = Vector3.new(20, 10, 20),
                DAMAGE = 10,
                REPAIR_RATE = 1,
                EFFECTS = {SMOKE = true, FIRE = true}
            },
            POWER_PLANT = {
                HEALTH = 250,
                SIZE = Vector3.new(15, 15, 15),
                DAMAGE = 8,
                REPAIR_RATE = 3,
                EFFECTS = {ENERGY = true, LIGHTS = true}
            },
            HOSPITAL = {
                HEALTH = 180,
                SIZE = Vector3.new(12, 12, 12),
                DAMAGE = 7,
                REPAIR_RATE = 2,
                EFFECTS = {LIGHTS = true, MEDICAL = true}
            },
            MILITARY_BASE = {
                HEALTH = 300,
                SIZE = Vector3.new(25, 15, 25),
                DAMAGE = 15,
                REPAIR_RATE = 1,
                EFFECTS = {SMOKE = true, FIRE = true, LIGHTS = true}
            }
        },
        
        CreateBuilding = function(self: BuildingSystem, buildingType: string, position: Vector3): Model
            local building = Instance.new("Model")
            building.Name = buildingType
            
            -- Set up building attributes
            local buildingInfo = self.BUILDING_TYPES[buildingType]
            if not buildingInfo then
                error("Invalid building type: " .. tostring(buildingType))
            end
            
            -- Create primary part
            local part = Instance.new("Part")
            part.Size = buildingInfo.SIZE
            part.Position = position
            part.Anchored = true
            part.Parent = building
            
            -- Add health value
            local health = Instance.new("NumberValue")
            health.Name = "Health"
            health.Value = buildingInfo.HEALTH
            health.Parent = building
            
            -- Add max health for reference
            local maxHealth = Instance.new("NumberValue")
            maxHealth.Name = "MaxHealth"
            maxHealth.Value = buildingInfo.HEALTH
            maxHealth.Parent = building
            
            -- Add building type
            local typeValue = Instance.new("StringValue")
            typeValue.Name = "BuildingType"
            typeValue.Value = buildingType
            typeValue.Parent = building
            
            -- Add effects folder
            local effects = Instance.new("Folder")
            effects.Name = "Effects"
            effects.Parent = building
            
            -- Initialize effects
            for effectName, _ in pairs(buildingInfo.EFFECTS) do
                local effect = Instance.new("BoolValue")
                effect.Name = effectName
                effect.Value = true
                effect.Parent = effects
            end
            
            return building
        end,
        
        CalculateDamage = function(self: BuildingSystem, building: Model, damage: number): boolean
            local health = building:FindFirstChild("Health")
            if not health or not health:IsA("NumberValue") then
                return false
            end
            
            health.Value = math.max(0, health.Value - damage)
            return health.Value > 0
        end,
        
        RepairBuilding = function(self: BuildingSystem, building: Model): boolean
            local health = building:FindFirstChild("Health")
            local maxHealth = building:FindFirstChild("MaxHealth")
            
            if not health or not health:IsA("NumberValue") or 
               not maxHealth or not maxHealth:IsA("NumberValue") then
                return false
            end
            
            local buildingType = building:FindFirstChild("BuildingType")
            if not buildingType or not buildingType:IsA("StringValue") then
                return false
            end
            
            local buildingInfo = self.BUILDING_TYPES[buildingType.Value]
            if not buildingInfo then
                return false
            end
            
            health.Value = math.min(maxHealth.Value, health.Value + buildingInfo.REPAIR_RATE)
            return true
        end,
        
        GetBuildingHealth = function(self: BuildingSystem, building: Model): number?
            local health = building:FindFirstChild("Health")
            if not health or not health:IsA("NumberValue") then
                return nil
            end
            return health.Value
        end
    }
    
    -- Test 1: Create a building and verify its properties
    local testPosition = Vector3.new(0, 0, 0)
    local building = BuildingSystem:CreateBuilding("SKYSCRAPER", testPosition)
    
    if not building or not building:IsA("Model") then
        return false, "Failed to create building"
    end
    
    -- Verify building properties
    if building.Name ~= "SKYSCRAPER" then
        return false, "Building name does not match type"
    end
    
    local health = building:FindFirstChild("Health")
    if not health or not health:IsA("NumberValue") then
        return false, "Building is missing Health value"
    end
    
    if health.Value ~= 200 then
        return false, string.format("Expected health 200, got %d", health.Value)
    end
    
    -- Test 2: Damage the building
    local isAlive = BuildingSystem:CalculateDamage(building, 50)
    if not isAlive then
        return false, "Building should still be alive after 50 damage"
    end
    
    local currentHealth = BuildingSystem:GetBuildingHealth(building)
    if currentHealth ~= 150 then
        return false, string.format("Expected health 150 after damage, got %d", currentHealth or -1)
    end
    
    -- Test 3: Repair the building
    local repairSuccess = BuildingSystem:RepairBuilding(building)
    if not repairSuccess then
        return false, "Failed to repair building"
    end
    
    currentHealth = BuildingSystem:GetBuildingHealth(building)
    if currentHealth ~= 152 then -- 150 + 2 (REPAIR_RATE for SKYSCRAPER)
        return false, string.format("Expected health 152 after repair, got %d", currentHealth or -1)
    end
    
    -- Test 4: Test building destruction
    isAlive = BuildingSystem:CalculateDamage(building, 200)
    if isAlive then
        return false, "Building should be destroyed after 200 damage"
    end
    
    currentHealth = BuildingSystem:GetBuildingHealth(building)
    if currentHealth ~= 0 then
        return false, string.format("Expected health 0 after destruction, got %d", currentHealth or -1)
    end
    
    -- Test 5: Test invalid building type
    local success, errorMsg = pcall(function()
        return BuildingSystem:CreateBuilding("INVALID_TYPE", testPosition)
    end)
    
    if success then
        return false, "Expected error for invalid building type, but none was raised"
    end
    
    if not errorMsg:find("Invalid building type") then
        return false, string.format("Unexpected error message: %s", tostring(errorMsg))
    end
    
    return true, "All BuildingSystem tests passed"
end

-- Run the test and return the result
local success, result = pcall(testBuildingSystem)
if not success then
    print("❌ Test failed with error:", tostring(result))
    return {success = false, message = "Test failed with error: " .. tostring(result)}
end

local testPassed, message = result
if testPassed then
    print("✅ " .. message)
    return {success = true, message = message}
else
    print("❌ " .. tostring(message))
    return {success = false, message = message}
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">CharacterSystemDirectTest</string>
          <string name="Source"><![CDATA[--!strict
-- CharacterSystemDirectTest.luau
-- A direct test for CharacterSystem functionality with strict Luau types

print("=== Starting CharacterSystemDirectTest ===")

-- Types
type ClassAttributes = {
    MaxHealth: number
}

type CharacterSystem = {
    CLASS_ATTRIBUTES: {[string]: ClassAttributes},
    onCharacterAdded: (self: CharacterSystem, character: Instance) -> boolean,
    onPlayerAdded: (self: CharacterSystem, player: Instance) -> boolean
}

-- Define the test function
local function testCharacterSystem(): (boolean, string)
    -- Mock the CharacterSystem with proper types
    local CharacterSystem: CharacterSystem = {
        CLASS_ATTRIBUTES = {
            Kaiju = { MaxHealth = 500 },
            Guardian = { MaxHealth = 200 },
            Engineer = { MaxHealth = 150 }
        },
        
        onCharacterAdded = function(self: CharacterSystem, character: Instance): boolean
            -- Mock implementation of onCharacterAdded
            local player = character:FindFirstChild("Player")
            if not player then return false end
            
            local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid?
            if not humanoid then return false end
            
            local playerClass = player:FindFirstChild("PlayerClass") :: StringValue?
            if not playerClass or not playerClass:IsA("StringValue") then return false end
            
            local className = playerClass.Value
            local attributes = self.CLASS_ATTRIBUTES[className]
            if not attributes then return false end
            
            -- Set health based on class
            humanoid.MaxHealth = attributes.MaxHealth
            humanoid.Health = attributes.MaxHealth
            
            return true
        end,
        
        onPlayerAdded = function(self: CharacterSystem, player: Instance): boolean
            -- Mock implementation of onPlayerAdded
            local character = player:FindFirstChild("Character")
            if character then
                return self:onCharacterAdded(character)
            end
            return false
        end
    }
    
    -- Test data
    type TestCase = {
        className: string,
        expectedHealth: number
    }
    
    local testCases: {TestCase} = {
        { className = "Kaiju", expectedHealth = 500 },
        { className = "Guardian", expectedHealth = 200 },
        { className = "Engineer", expectedHealth = 150 }
    }
    
    -- Run tests for each class
    for _, testCase in ipairs(testCases) do
        local className = testCase.className
        local expectedHealth = testCase.expectedHealth
        
        -- Create test character
        local character = Instance.new("Model")
        
        -- Create and configure humanoid
        local humanoid = Instance.new("Humanoid")
        humanoid.Parent = character
        
        -- Create player reference
        local player = Instance.new("Model")
        local playerClass = Instance.new("StringValue")
        playerClass.Name = "PlayerClass"
        playerClass.Value = className
        playerClass.Parent = player
        
        -- Link player to character
        local playerRef = Instance.new("ObjectValue")
        playerRef.Name = "Player"
        playerRef.Value = player
        playerRef.Parent = character
        
        -- Test onCharacterAdded
        local success = CharacterSystem:onCharacterAdded(character)
        
        -- Verify results
        if not success then
            return false, string.format("Failed to set up %s character", className)
        end
        
        if humanoid.MaxHealth ~= expectedHealth then
            return false, string.format("%s MaxHealth should be %d, got %d", 
                className, expectedHealth, humanoid.MaxHealth)
        end
        
        if humanoid.Health ~= expectedHealth then
            return false, string.format("%s Health should be %d, got %d", 
                className, expectedHealth, humanoid.Health)
        end
    end
    
    -- Test invalid class
    local invalidCharacter = Instance.new("Model")
    local invalidHumanoid = Instance.new("Humanoid")
    invalidHumanoid.Parent = invalidCharacter
    
    local invalidPlayer = Instance.new("Model")
    local invalidClass = Instance.new("StringValue")
    invalidClass.Name = "PlayerClass"
    invalidClass.Value = "InvalidClass"
    invalidClass.Parent = invalidPlayer
    
    local playerRef = Instance.new("ObjectValue")
    playerRef.Name = "Player"
    playerRef.Value = invalidPlayer
    playerRef.Parent = invalidCharacter
    
    -- Should not error with invalid class, just return false
    local success = pcall(function()
        return CharacterSystem:onCharacterAdded(invalidCharacter)
    end)
    
    if not success then
        return false, "onCharacterAdded should handle invalid classes gracefully"
    end
    
    -- Verify humanoid wasn't modified
    if invalidHumanoid.MaxHealth ~= 100 then -- Default Humanoid max health
        return false, "Invalid class should not modify Humanoid health"
    end
    
    return true, "All CharacterSystem tests passed"
end

-- Run the test and return the result
local success, result = pcall(testCharacterSystem)
if not success then
    print("❌ Test failed with error:", tostring(result))
    return {success = false, message = "Test failed with error: " .. tostring(result)}
end

local testPassed, message = result
if testPassed then
    print("✅ " .. message)
    return {success = true, message = message}
else
    print("❌ " .. tostring(message))
    return {success = false, message = message}
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">CharacterSystemTest</string>
          <string name="Source"><![CDATA[--!strict
-- CharacterSystemTest.luau
-- A test for CharacterSystem functionality using mock objects with strict Luau types

-- Types
type MockInstance = {
    ClassName: string,
    Name: string,
    _children: {MockInstance},
    _parent: MockInstance?,
    _properties: {[string]: any},
    Parent: Instance?,
    FindFirstChild: (self: MockInstance, name: string, recursive: boolean?) -> MockInstance?,
    FindFirstChildOfClass: (self: MockInstance, className: string) -> MockInstance?,
    IsA: (self: MockInstance, className: string) -> boolean,
    GetChildren: (self: MockInstance) -> {MockInstance},
    MaxHealth: number?,
    Health: number?,
    Value: any
}

type CharacterSystem = {
    CLASS_ATTRIBUTES: {
        [string]: {
            MaxHealth: number
        }
    },
    onCharacterAdded: (self: CharacterSystem, character: Instance) -> boolean,
    onPlayerAdded: (self: CharacterSystem, player: Instance) -> boolean
}

-- Mock instance system
local MockInstance = {}
MockInstance.__index = MockInstance

function MockInstance.new(className: string, name: string?): MockInstance
    local self: MockInstance = {
        ClassName = className,
        Name = name or className,
        _children = {},
        _parent = nil :: MockInstance?,
        _properties = {},
        Parent = nil,
        MaxHealth = 100,
        Health = 100,
        Value = nil
    }
    return setmetatable(self, MockInstance) :: any
end

function MockInstance:FindFirstChild(name: string, recursive: boolean?): MockInstance?
    if not self._children then return nil end
    
    -- First check direct children
    for _, child in ipairs(self._children) do
        if child.Name == name then
            return child
        end
    end
    
    -- Then check recursively if requested
    if recursive then
        for _, child in ipairs(self._children) do
            local found = child:FindFirstChild(name, true)
            if found then
                return found
            end
        end
    end
    
    return nil
end

function MockInstance:FindFirstChildOfClass(className: string): MockInstance?
    if not self._children then return nil end
    
    for _, child in ipairs(self._children) do
        if child.ClassName == className then
            return child
        end
        
        -- Search recursively
        local found = child:FindFirstChildOfClass(className)
        if found then
            return found
        end
    end
    
    return nil
end

function MockInstance:IsA(className: string): boolean
    return self.ClassName == className
end

function MockInstance:GetChildren(): {MockInstance}
    return self._children or {}
end

-- Create mock CharacterSystem
local function createMockCharacterSystem(): CharacterSystem
    local mock: CharacterSystem = {
        CLASS_ATTRIBUTES = {
            Kaiju = { MaxHealth = 500 },
            Guardian = { MaxHealth = 200 },
            Engineer = { MaxHealth = 150 }
        },
        
        onCharacterAdded = function(self: CharacterSystem, character: Instance): boolean
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid then return false end
            
            local playerValue = character:FindFirstChild("Player")
            if not playerValue or not playerValue:IsA("ObjectValue") then return false end
            
            local player = playerValue.Value
            if not player then return false end
            
            local playerClass = player:FindFirstChild("PlayerClass")
            if not playerClass or not playerClass:IsA("StringValue") then return false end
            
            local attributes = self.CLASS_ATTRIBUTES[playerClass.Value]
            if not attributes then return false end
            
            -- Set health based on class
            humanoid.MaxHealth = attributes.MaxHealth
            humanoid.Health = attributes.MaxHealth
            
            return true
        end,
        
        onPlayerAdded = function(self: CharacterSystem, player: Instance): boolean
            -- Mock implementation of onPlayerAdded
            if player:FindFirstChild("Character") then
                return self:onCharacterAdded(player.Character)
            end
            return false
        end
    }
    
    return mock
end

-- Create instance of mock system
local mockCharacterSystem = createMockCharacterSystem()

-- Test data
type TestCase = {
    className: string,
    expectedHealth: number
}

local testCases: {TestCase} = {
    { className = "Kaiju", expectedHealth = 500 },
    { className = "Guardian", expectedHealth = 200 },
    { className = "Engineer", expectedHealth = 150 }
}

-- Run tests and print results
local function runTests(): (number, number)
    local testSuccessCount = 0
    local testFailureCount = 0
    
    for _, testCase in ipairs(testCases) do
        local className = testCase.className
        local expectedHealth = testCase.expectedHealth
        
        print(string.format("\nTesting %s character setup...", className))
        
        -- Create mock player and character
        local player = Instance.new("Model")
        player.Name = "TestPlayer"
        
        local playerClass = Instance.new("StringValue")
        playerClass.Name = "PlayerClass"
        playerClass.Value = className
        playerClass.Parent = player
        
        local character = Instance.new("Model")
        character.Name = "TestCharacter"
        
        local humanoid = Instance.new("Humanoid")
        humanoid.Parent = character
        
        -- Add player reference to character
        local playerRef = Instance.new("ObjectValue")
        playerRef.Name = "Player"
        playerRef.Value = player
        playerRef.Parent = character
        
        -- Test onCharacterAdded
        local testSuccess = mockCharacterSystem:onCharacterAdded(character)
        
        if testSuccess then
            -- Verify health was set correctly
            if humanoid.MaxHealth == expectedHealth and humanoid.Health == expectedHealth then
                print(string.format("✅ %s character setup passed", className))
                testSuccessCount = testSuccessCount + 1
            else
                print(string.format("❌ %s health mismatch: expected %d, got %d/%d", 
                    className, expectedHealth, humanoid.Health, humanoid.MaxHealth))
                testFailureCount = testFailureCount + 1
            end
        else
            print(string.format("❌ %s setup failed", className))
            testFailureCount = testFailureCount + 1
        end
    end
    
    -- Test invalid class
    print("\nTesting invalid class handling...")
    local invalidPlayer = Instance.new("Model")
    invalidPlayer.Name = "InvalidPlayer"
    
    local invalidClass = Instance.new("StringValue")
    invalidClass.Name = "PlayerClass"
    invalidClass.Value = "InvalidClass"
    invalidClass.Parent = invalidPlayer
    
    local invalidCharacter = Instance.new("Model")
    invalidCharacter.Name = "InvalidCharacter"
    
    local invalidHumanoid = Instance.new("Humanoid")
    invalidHumanoid.Parent = invalidCharacter
    
    local playerRef = Instance.new("ObjectValue")
    playerRef.Name = "Player"
    playerRef.Value = invalidPlayer
    playerRef.Parent = invalidCharacter
    
    -- Should not error with invalid class, just return false
    local success = pcall(function()
        return mockCharacterSystem:onCharacterAdded(invalidCharacter)
    end)
    
    if success and invalidHumanoid.MaxHealth == 100 then -- Default Humanoid max health
        print("✅ Invalid class handling passed")
        testSuccessCount = testSuccessCount + 1
    else
        print("❌ Invalid class handling failed")
        testFailureCount = testFailureCount + 1
    end
    
    return testSuccessCount, testFailureCount
end

-- Run tests and print summary
local successCount, failureCount = runTests()

-- Print summary
print("\n=== Test Summary ===")
print(string.format("Total Tests: %d", successCount + failureCount))
print(string.format("✅ Passed: %d", successCount))
print(string.format("❌ Failed: %d", failureCount))

-- Return overall result
return {
    success = failureCount == 0,
    message = string.format("CharacterSystem tests completed. %d passed, %d failed", 
        successCount, failureCount)
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">ClassSystemDirectTest</string>
          <string name="Source"><![CDATA[--!strict
-- ClassSystemDirectTest.luau
-- A direct test for ClassSystem functionality with strict Luau types

print("=== Starting ClassSystemDirectTest ===")

-- Types
type Player = {
    Name: string,
    Character: {
        Name: string
    },
    FindFirstChild: ((self: Player, name: string, recursive: boolean?) -> Instance)?
}

type PlayerClass = {
    Name: string,
    Value: string,
    Parent: Player,
    ClassName: string
}

type ClassSystem = {
    CLASSES: {string},
    onPlayerAdded: (self: ClassSystem, player: Player) -> PlayerClass
}

-- Define the test function
local function testClassSystem(): (boolean, string)
    -- Mock the minimal required parts of ClassSystem
    local ClassSystem: ClassSystem = {
        CLASSES = {"Kaiju", "Guardian", "Engineer"},
        onPlayerAdded = function(_: ClassSystem, player: Player): PlayerClass
            return {
                Name = "PlayerClass",
                Value = "Kaiju",
                Parent = player,
                ClassName = "StringValue"
            }
        end
    }

    -- Create a mock player
    local player: Player = {
        Name = "TestPlayer",
        Character = {Name = "TestCharacter"}
    }

    -- Test the onPlayerAdded function
    local success, playerClass = pcall(ClassSystem.onPlayerAdded, ClassSystem, player)
    
    -- Verify the results
    if not success then
        return false, "onPlayerAdded failed with error: " .. tostring(playerClass)
    end
    
    if not playerClass then
        return false, "onPlayerAdded returned nil"
    end
    
    if playerClass.Name ~= "PlayerClass" then
        return false, "PlayerClass name is incorrect: " .. tostring(playerClass.Name)
    end
    
    if playerClass.Parent ~= player then
        return false, "PlayerClass parent is not set to player"
    end
    
    -- Check if the assigned class is valid
    local isValidClass = false
    for _, className in ipairs(ClassSystem.CLASSES) do
        if className == playerClass.Value then
            isValidClass = true
            break
        end
    end
    
    if not isValidClass then
        return false, string.format("Assigned class '%s' is not in the valid classes list", playerClass.Value)
    end
    
    return true, "All ClassSystem tests passed"
end

-- Run the test and return the result
local success, result = pcall(testClassSystem)
if not success then
    print("❌ Test failed with error:", tostring(result))
    return {success = false, message = "Test failed with error: " .. tostring(result)}
end

local testPassed, message = result
if testPassed then
    print("✅ " .. message)
    return {success = true, message = message}
else
    print("❌ " .. tostring(message))
    return {success = false, message = message}
end
]]></string>
        </Properties>
